{
  "name": "sdet-engineering-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Senior SDET Engineering Portfolio and Technical Architecture Showcase",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:chromium": "playwright test --project=desktop-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:validate:content": "python3 scripts/validate_content.py",
    "test:validate:links": "python3 scripts/validate_links.py",
    "test:validate": "npm run test:validate:content && npm run test:validate:links",
    "test": "npm run test:validate && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
