---
// src/pages/contact.astro
import BaseLayout from '@layouts/BaseLayout.astro';

const contactEmail = 'contact@example.com';
const githubUrl = 'https://github.com';
const linkedinUrl = 'https://linkedin.com';

const engagementTypes = [
  {
    title: 'International Remote SDET Roles',
    description:
      'Senior Software Development Engineer in Test or Lead Quality Engineer opportunities across US, EU, and global distributed engineering teams.',
  },
  {
    title: 'Framework Architecture & Migration',
    description:
      'Transitioning legacy Selenium suites to modern Playwright/TypeScript architecture with hermetic fixtures and parallel execution.',
  },
  {
    title: 'Test Reliability & Flakiness Triage',
    description:
      'Systematic diagnosis of failing CI pipelines, root-cause isolation, and stabilization of flaky regression suites.',
  },
  {
    title: 'CI/CD Quality Gate Consulting',
    description:
      'Integrating automated test sharding, containerized Docker runners, and automated Allure test reporting into GitHub Actions.',
  },
];
---

<BaseLayout
  title="Contact & Professional Inquiries | Senior SDET"
  description="Initiate a professional conversation regarding international remote SDET roles, framework architecture engagements, and quality engineering consulting."
>
  <div class="contact-page">
    <div class="container">
      <header class="page-header">
        <span class="page-kicker">Professional Inquiries</span>
        <h1 class="page-title">Initiate a Conversation</h1>
        <p class="page-lead">
          I am actively available for international remote positions, high-impact contract
          engagements, and quality engineering advisory. Let's discuss how we can engineer reliable
          testing systems for your product.
        </p>
      </header>

      <div class="contact-grid">
        <!-- Direct Channels -->
        <div class="contact-channels">
          <div class="channel-card primary-channel">
            <span class="channel-kicker">Primary Contact Channel</span>
            <h2 class="channel-title">Direct Email</h2>
            <p class="channel-description">
              Send a direct message regarding role requirements, framework architecture questions,
              or consulting inquiries.
            </p>
            <a href={`mailto:${contactEmail}`} class="email-btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{contactEmail}</span>
            </a>
          </div>

          <div class="channel-card">
            <span class="channel-kicker">Professional Profiles</span>
            <h2 class="channel-title">Code &amp; Career Network</h2>
            <div class="profiles-list">
              <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="profile-item">
                <div class="profile-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                    ></path>
                  </svg>
                </div>
                <div class="profile-details">
                  <span class="profile-name">GitHub</span>
                  <span class="profile-sub"
                    >Inspect framework repositories &amp; open-source work</span
                  >
                </div>
                <span class="sr-only"> (opens in new tab)</span>
              </a>

              <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="profile-item">
                <div class="profile-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                    ></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </div>
                <div class="profile-details">
                  <span class="profile-name">LinkedIn</span>
                  <span class="profile-sub">View professional timeline &amp; endorsements</span>
                </div>
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Areas of Engagement -->
        <div class="engagement-overview">
          <h2 class="engagement-heading">Engagement Scenarios</h2>
          <div class="engagement-list">
            {
              engagementTypes.map((eng) => (
                <div class="engagement-item">
                  <h3 class="engagement-title">{eng.title}</h3>
                  <p class="engagement-desc">{eng.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .page-header {
    max-width: 800px;
    margin-bottom: var(--space-12);
  }

  .page-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .channel-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }

  .primary-channel {
    border-color: color-mix(in srgb, var(--accent-primary) 35%, transparent);
    background-color: var(--bg-surface-elevated);
  }

  .channel-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .channel-title {
    font-size: var(--text-xl);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .channel-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--accent-primary);
    color: var(--text-inverse);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .email-btn:hover {
    background-color: var(--accent-hover);
    text-decoration: none;
  }

  .profiles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .profile-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    background-color: var(--bg-primary);
    transition: border-color var(--transition-fast);
  }

  .profile-item:hover {
    border-color: var(--border-default);
  }

  .profile-icon {
    color: var(--accent-primary);
  }

  .profile-details {
    display: flex;
    flex-direction: column;
  }

  .profile-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .profile-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Engagement Overview */
  .engagement-overview {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }

  .engagement-heading {
    font-size: var(--text-xl);
    margin-top: 0;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .engagement-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .engagement-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: var(--space-1);
  }

  .engagement-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
