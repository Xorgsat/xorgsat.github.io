---
// src/pages/contact.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '../config/profile';

const engagementTypes = [
  {
    title: 'International Remote SDET Roles',
    description:
      'Senior Software Development Engineer in Test or Lead Quality Engineer opportunities across US, EU, and global distributed engineering teams.',
  },
  {
    title: 'Framework Architecture & Migration',
    description:
      'Transitioning legacy Selenium suites to modern Playwright/TypeScript architecture with hermetic fixtures and parallel execution.',
  },
  {
    title: 'Test Reliability & Flakiness Triage',
    description:
      'Systematic diagnosis of failing CI pipelines, root-cause isolation, and stabilization of flaky regression suites.',
  },
  {
    title: 'CI/CD Quality Gate Consulting',
    description:
      'Integrating automated test sharding, containerized Docker runners, and automated Allure test reporting into GitHub Actions.',
  },
];
---

<BaseLayout
  title={`Contact ${profile.name} | Senior SDET & Quality Engineering Architect`}
  description={`Initiate a professional conversation with ${profile.name} regarding international remote SDET roles, framework architecture engagements, and quality engineering consulting.`}
>
  <div class="contact-page blueprint-grid">
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">GET IN TOUCH</span>
        <h1 class="display-title page-title">
          Initiate an Engineering Discussion<span class="accent-text">.</span>
        </h1>
        <p class="page-lead">
          Open to Senior and Staff SDET opportunities, test architecture consultations, and quality
          engineering advisory. Let's discuss building scalable, reliable test systems for your
          product.
        </p>
      </header>

      <div class="contact-grid">
        <!-- Direct Channels -->
        <div class="contact-channels">
          <div class="channel-card primary-channel blueprint-frame">
            <span class="mono text-xs text-lime">PRIMARY INQUIRY CHANNEL</span>
            <h2 class="channel-title">Direct Email</h2>
            <p class="channel-description">
              Send a direct message regarding role requirements, framework architecture questions,
              or consulting inquiries.
            </p>
            <a href={`mailto:${profile.email}`} class="btn btn-primary email-btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{profile.email}</span>
            </a>
          </div>

          <div class="channel-card blueprint-frame">
            <span class="mono text-xs text-blue">VERIFIED PROFILES &amp; RESUME</span>
            <h2 class="channel-title">Code Repositories &amp; Network</h2>
            <div class="profiles-list">
              <a
                href={profile.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="profile-item"
              >
                <div class="profile-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                    ></path>
                  </svg>
                </div>
                <div class="profile-details">
                  <span class="profile-name">GitHub (Xorgsat)</span>
                  <span class="profile-sub"
                    >Inspect framework repositories &amp; open-source implementations</span
                  >
                </div>
                <span class="sr-only"> (opens in new tab)</span>
              </a>

              <a
                href={profile.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="profile-item"
              >
                <div class="profile-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                    ></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </div>
                <div class="profile-details">
                  <span class="profile-name">LinkedIn Profile</span>
                  <span class="profile-sub"
                    >View career trajectory, recommendations &amp; network</span
                  >
                </div>
                <span class="sr-only"> (opens in new tab)</span>
              </a>

              <a
                href={profile.resumeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="profile-item"
              >
                <div class="profile-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                </div>
                <div class="profile-details">
                  <span class="profile-name">Curriculum Vitae (PDF)</span>
                  <span class="profile-sub">Download verified engineering resume</span>
                </div>
                <span class="sr-only"> (opens PDF in new tab)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Areas of Engagement -->
        <div class="engagement-overview blueprint-frame">
          <div class="panel-head-bar">
            <span class="mono text-xs text-blue">ENGAGEMENT ARCHITECTURE</span>
          </div>
          <div class="engagement-inner">
            <h2 class="engagement-heading">Engagement Scenarios</h2>
            <div class="engagement-list">
              {
                engagementTypes.map((eng) => (
                  <div class="engagement-item">
                    <h3 class="engagement-title">{eng.title}</h3>
                    <p class="engagement-desc">{eng.description}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .page-header {
    max-width: 820px;
    margin-bottom: var(--space-10);
  }

  .page-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .channel-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .primary-channel {
    border-color: var(--border-strong);
  }

  .channel-title {
    font-size: var(--text-xl);
    margin: var(--space-2) 0 var(--space-2) 0;
    color: var(--text);
  }

  .channel-description {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
  }

  .profiles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .profile-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface-soft);
    text-decoration: none;
    color: var(--text);
    transition:
      border-color var(--duration-fast),
      transform var(--duration-fast);
  }

  .profile-item:hover {
    border-color: var(--blue);
    transform: translateX(4px);
  }

  .profile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
  }

  .profile-details {
    display: flex;
    flex-direction: column;
  }

  .profile-name {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .profile-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .engagement-overview {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: fit-content;
  }

  .panel-head-bar {
    padding: 10px 18px;
    background-color: var(--surface-soft);
    border-bottom: 1px dashed var(--border);
  }

  .engagement-inner {
    padding: var(--space-6);
  }

  .engagement-heading {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4) 0;
    color: var(--text);
  }

  .engagement-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .engagement-item {
    padding-bottom: var(--space-3);
    border-bottom: 1px dashed var(--border);
  }

  .engagement-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .engagement-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 4px 0;
  }

  .engagement-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .text-blue {
    color: var(--blue);
  }
  .text-lime {
    color: var(--lime);
  }
</style>
