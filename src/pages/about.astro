---
// src/pages/about.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { profile } from '../config/profile';

const coreCompetencies = [
  'Test Automation Framework Engineering',
  'Hermetic State & Test Data Isolation',
  'Flaky Test Root-Cause Elimination',
  'API Contract & Integration Testing',
  'Mobile Automation (Android & iOS)',
  'Performance & Latency Threshold Auditing',
  'CI/CD Pipeline Test Sharding & Tooling',
  'Quality Strategy & Risk-Based Testing',
];

const technicalLanguages = [
  'TypeScript',
  'JavaScript',
  'Python',
  'C',
  'SQL',
  'Bash',
  'Java (Basic)',
  'Rust (Basic)',
];

const automationTools = [
  'Playwright',
  'Puppeteer',
  'Selenium WebDriver',
  'Appium',
  'k6',
  'JMeter',
  'SuperTest',
  'Requests',
];

const infrastructureTools = ['Docker', 'Kubernetes', 'GitHub Actions', 'Linux', 'Allure', 'Git'];

const careerMilestones = [
  {
    period: '2023 — PRESENT',
    role: 'Senior SDET & Quality Engineering Architect',
    focus: 'Enterprise Test Systems & Dual-Harness Web Architecture',
    description:
      'Architected the Browser Reliability Engineering Lab (BREL) and multi-tier financial transaction testing suites. Led quality engineering across fintech platforms featured on Shark Tank India (Season 5). Implemented hermetic test fixtures and containerized parallel execution across 6+ PR merges per day.',
    deliverables: [
      'BREL Dual-Harness Engine',
      'Banking Double-Entry Invariant Test Architecture',
      'Allure & Playwright Tracing Pipelines',
    ],
  },
  {
    period: '2021 — 2023',
    role: 'Lead SDET / Senior Automation Engineer',
    focus: 'Microservices Quality & Distributed Load Engineering',
    description:
      'Engineered automated contract verification suites using OpenAPI 3.1 and Pact. Built distributed performance testing frameworks with k6 and Grafana QuickPizza simulating 5,000 virtual users with p99 latency thresholds under 180ms.',
    deliverables: [
      'k6 Distributed Benchmark Suite',
      'Microservices Fault Injection Harness',
      '9.6x Regression Acceleration (24h to 2.5h)',
    ],
  },
  {
    period: '2019 — 2021',
    role: 'SDET / Automation Engineer',
    focus: 'Cross-Platform UI & Mobile Quality Engineering',
    description:
      'Developed native and hybrid mobile test suites across Android and iOS emulators using Appium 2.x and WebDriverIO. Transitioned legacy manual workflows into automated regression test matrices, scaling test coverage from 60% to 94%.',
    deliverables: [
      'Finosauras Mobile Automation Framework',
      'Cross-Browser Selenium Grid',
      'Zero-Escape Regression Verification',
    ],
  },
  {
    period: '2016 — 2019',
    role: 'QA Engineer / Automation Foundations',
    focus: 'Core Test Automation & Framework Design',
    description:
      'Spearheaded the engineering of initial automation test suites across web applications and REST APIs. Created Page Object component libraries and established continuous regression verification in CI/CD.',
    deliverables: [
      'REST API Test Harnesses',
      'Component Object Pattern Libraries',
      'Initial 1,500+ Automated Tests',
    ],
  },
];
---

<BaseLayout
  title="About | Senior SDET & Quality Engineering Architect"
  description="Professional background, 8 years of quality engineering experience, verified career metrics, automation architecture philosophy, and technical competencies."
>
  <div class="about-page blueprint-grid">
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">PROFESSIONAL PROFILE // CAREER SPECIFICATION</span>
        <h1 class="display-title page-title">
          Engineering Mindset &amp; Experience<span class="accent-text">.</span>
        </h1>
        <p class="page-lead">
          Senior Software Development Engineer in Test (SDET) and Quality Engineering Architect with <strong
            >{profile.experienceYears} years of dedicated experience</strong
          >
          designing, implementing, and stabilizing quality engineering systems across high-growth product
          teams and mission-critical distributed platforms.
        </p>
      </header>

      <div class="about-grid">
        <!-- Main Narrative Column -->
        <div class="about-content">
          <!-- Overview Section -->
          <section class="about-section">
            <h2 class="section-title">Professional Architecture Overview</h2>
            <p>
              Over the past eight years, my focus has centered on solving the hardest problems in
              software testing:
              <strong>architectural maintainability, execution speed, and test determinism</strong>.
            </p>
            <p>
              Rather than viewing automation as merely translating manual test cases into scripts, I
              treat test frameworks as critical production software products. A poorly architected
              test suite creates drag on delivery velocity; a well-architected framework acts as a
              force multiplier that empowers engineering teams to deploy to production with absolute
              confidence multiple times a day.
            </p>
          </section>

          <!-- Interactive Architectural Career Timeline -->
          <section class="about-section">
            <h2 class="section-title">8-Year Architectural Evolution Timeline</h2>
            <p>
              Milestones tracking the engineering progression from foundational automation scripting
              to full-stack quality architecture and distributed system reliability.
            </p>

            <div class="timeline">
              {
                careerMilestones.map((m) => (
                  <div class="timeline-item blueprint-frame">
                    <div class="timeline-meta">
                      <span class="timeline-period mono text-xs">{m.period}</span>
                      <span class="timeline-tag mono text-xs">{m.focus}</span>
                    </div>
                    <h3 class="timeline-role">{m.role}</h3>
                    <p class="timeline-desc">{m.description}</p>
                    <div class="timeline-delivs">
                      <span class="mono text-xs text-dim">VERIFIED DELIVERABLES:</span>
                      <ul class="deliv-pills">
                        {m.deliverables.map((d) => (
                          <li class="mono text-xs">{d}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Verified Career Metrics Inventory -->
          <section class="about-section">
            <h2 class="section-title">Verified Testing Portfolio &amp; Career Metrics</h2>
            <p>
              Across eight years of dedicated quality engineering, I operate with an evidence-based
              approach to testing. All figures below represent aggregated, verifiable data from
              enterprise and commercial delivery environments:
            </p>

            <div class="metrics-summary-cards">
              <div class="summary-mini-card blueprint-frame">
                <span class="mini-card-number">{profile.metrics.totalTestsHandled}</span>
                <span class="mini-card-label">Test Cases Handled</span>
                <span class="mini-card-sub mono text-xs">Across 8-year SDET career</span>
              </div>
              <div class="summary-mini-card blueprint-frame">
                <span class="mini-card-number">{profile.metrics.automatedTests}</span>
                <span class="mini-card-label">Automated Tests</span>
                <span class="mini-card-sub mono text-xs"
                  >{profile.metrics.automationShare} lifetime automation share</span
                >
              </div>
              <div class="summary-mini-card blueprint-frame">
                <span class="mini-card-number">{profile.metrics.frameworksCount}</span>
                <span class="mini-card-label">Custom Frameworks</span>
                <span class="mini-card-sub mono text-xs">Architected from the ground up</span>
              </div>
              <div class="summary-mini-card blueprint-frame">
                <span class="mini-card-number">{profile.metrics.regressionReduction}</span>
                <span class="mini-card-label">Regression Cycle Cut</span>
                <span class="mini-card-sub mono text-xs"
                  >{profile.metrics.regressionManualTime} to {
                    profile.metrics.regressionAutomatedTime
                  }</span
                >
              </div>
            </div>

            <h3 class="subsection-title">
              Automation by Framework ({profile.metrics.automatedTests} Tests)
            </h3>
            <div class="breakdown-table-wrapper blueprint-frame">
              <table class="metrics-table">
                <thead>
                  <tr>
                    <th>Framework</th>
                    <th>Automated Tests</th>
                    <th>Share of Automated Total</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    profile.metrics.frameworkBreakdown.map((f) => (
                      <tr>
                        <td class="font-medium">{f.name}</td>
                        <td>{f.count}</td>
                        <td class="font-mono text-accent">{f.share}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <h3 class="subsection-title">
              Testing Portfolio by Category ({profile.metrics.totalTestsHandled} Total Cases)
            </h3>
            <div class="breakdown-table-wrapper blueprint-frame">
              <table class="metrics-table">
                <thead>
                  <tr>
                    <th>Testing Category</th>
                    <th>Test Cases</th>
                    <th>Share of Total</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    profile.metrics.categoryBreakdown.map((c) => (
                      <tr>
                        <td class="font-medium">{c.category}</td>
                        <td>{c.count}</td>
                        <td class="font-mono text-accent">{c.share}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <h3 class="subsection-title">Quantified Delivery &amp; Reliability Impact</h3>
            <ul class="impact-list">
              <li>
                <strong>Regression Compression:</strong> Reduced manual regression cycles from approximately
                3 days (24 standard working hours) to 2.5 automated hours—yielding an <strong
                  >{profile.metrics.regressionReduction} reduction in execution time</strong
                > and an overall <strong
                  >{profile.metrics.regressionSpeedup} speed improvement</strong
                >.
              </li>
              <li>
                <strong>Coverage Expansion:</strong> Scaled project-specific automation coverage from
                <strong>{profile.metrics.coverageStart} to {profile.metrics.coverageEnd}</strong> ({
                  profile.metrics.coverageImprovement
                } percentage points), drastically reducing escaped defects in production.
              </li>
              <li>
                <strong>Defect Mitigation:</strong> Identified and isolated between <strong
                  >{profile.metrics.defectsIdentified} defects</strong
                > pre-production, protecting customer trust and platform availability.
              </li>
              <li>
                <strong>High-Velocity Delivery:</strong> Maintained regression stability in environments
                merging <strong>{profile.metrics.dailyPrMerges}</strong> across cross-functional engineering
                teams of {profile.metrics.teamSize}, including mission-critical fintech SaaS systems
                featured on <em>Shark Tank India (Season 5)</em>.
              </li>
            </ul>
          </section>

          <!-- Philosophy Section -->
          <section class="about-section">
            <h2 class="section-title">Approach to Automation Architecture</h2>
            <p>My architectural philosophy is anchored on three non-negotiable principles:</p>
            <ul class="principles-list">
              <li>
                <strong>Strict Test Isolation:</strong> Every automated scenario must generate its own
                test state via API or factory fixtures and clean up after itself. Shared mutable database
                state is the primary cause of intermittent pipeline failures.
              </li>
              <li>
                <strong>Zero Tolerance for Blind Retries:</strong> Configuring test runners to retry failing
                tests masks underlying race conditions and degrades pipeline trust. I systematically investigate
                failures to isolate whether the defect lies in element synchronization, unhandled asynchronous
                network traffic, or frontend hydration timing.
              </li>
              <li>
                <strong>Component Object Abstraction:</strong> Decoupling element locators from test logic
                ensures that when a frontend design system is updated, only a single component object
                is modified—preventing cascading breaks across dozens of test files.
              </li>
            </ul>
          </section>
        </div>

        <!-- Sidebar / Technical Inventory -->
        <aside class="about-sidebar">
          <div class="sidebar-card blueprint-frame">
            <h3 class="sidebar-heading mono text-xs text-blue">CORE COMPETENCIES</h3>
            <ul class="competencies-list">
              {coreCompetencies.map((comp) => <li>{comp}</li>)}
            </ul>
          </div>

          <div class="sidebar-card blueprint-frame">
            <h3 class="sidebar-heading mono text-xs text-blue">TECHNOLOGY INVENTORY</h3>

            <div class="tech-group">
              <span class="tech-group-title mono text-xs text-dim">Languages</span>
              <div class="tags-row">
                {technicalLanguages.map((t) => <TechTag label={t} variant="accent" />)}
              </div>
            </div>

            <div class="tech-group">
              <span class="tech-group-title mono text-xs text-dim">Automation Frameworks</span>
              <div class="tags-row">
                {automationTools.map((t) => <TechTag label={t} variant="default" />)}
              </div>
            </div>

            <div class="tech-group">
              <span class="tech-group-title mono text-xs text-dim"
                >Infrastructure &amp; Tooling</span
              >
              <div class="tags-row">
                {infrastructureTools.map((t) => <TechTag label={t} variant="default" />)}
              </div>
            </div>
          </div>

          <div class="sidebar-card resume-card blueprint-frame">
            <h3 class="sidebar-heading mono text-xs text-lime">CURRICULUM VITAE</h3>
            <p class="resume-text">
              Download Satyam Tiwari's verified curriculum vitae detailing career milestones and
              commercial engagements.
            </p>
            <a
              href={profile.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Resume (PDF)</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .page-header {
    max-width: 820px;
    margin-bottom: var(--space-10);
  }

  .page-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1.8fr 1fr;
    }
  }

  .about-section {
    margin-bottom: var(--space-10);
  }

  .section-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
    margin-top: 0;
    margin-bottom: var(--space-4);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
  }

  .subsection-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--text);
  }

  /* Timeline */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .timeline-item {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .timeline-period {
    color: var(--lime);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .timeline-tag {
    color: var(--blue);
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .timeline-role {
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--text);
    margin: 0 0 var(--space-2) 0;
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4) 0;
  }

  .timeline-delivs {
    padding-top: var(--space-3);
    border-top: 1px dashed var(--border);
  }

  .deliv-pills {
    list-style: none;
    margin: 6px 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .deliv-pills li {
    background-color: var(--surface-soft);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  /* Metrics Summary Cards */
  .metrics-summary-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .metrics-summary-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .summary-mini-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mini-card-number {
    font-size: 1.6rem;
    font-weight: 750;
    color: var(--text);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .mini-card-label {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--text);
  }

  .mini-card-sub {
    color: var(--text-dim);
  }

  /* Breakdown Tables */
  .breakdown-table-wrapper {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .metrics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .metrics-table th,
  .metrics-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .metrics-table th {
    background-color: var(--surface-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.05em;
  }

  .text-accent {
    color: var(--lime);
    font-weight: 700;
  }

  .impact-list,
  .principles-list {
    color: var(--text-muted);
    padding-left: var(--space-6);
    line-height: var(--leading-relaxed);
  }

  .impact-list li,
  .principles-list li {
    margin-bottom: var(--space-3);
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .sidebar-heading {
    margin: 0 0 var(--space-4) 0;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .competencies-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .competencies-list li {
    font-size: var(--text-sm);
    color: var(--text);
    padding-left: var(--space-4);
    position: relative;
  }

  .competencies-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--lime);
    font-weight: 700;
  }

  .tech-group {
    margin-bottom: var(--space-4);
  }

  .tech-group-title {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .resume-card {
    border-color: var(--border-strong);
  }

  .resume-text {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .text-blue {
    color: var(--blue);
  }
  .text-lime {
    color: var(--lime);
  }
  .text-dim {
    color: var(--text-dim);
  }
</style>
