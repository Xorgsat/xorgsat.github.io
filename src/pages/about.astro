---
// src/pages/about.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { profile } from '../config/profile';

const coreCompetencies = [
  'Test Automation Framework Engineering',
  'Hermetic State & Test Data Isolation',
  'Flaky Test Root-Cause Elimination',
  'API Contract & Integration Testing',
  'Mobile Automation (Android & iOS)',
  'Performance & Latency Threshold Auditing',
  'CI/CD Pipeline Test Sharding & Tooling',
  'Quality Strategy & Risk-Based Testing',
];

const technicalLanguages = [
  'TypeScript',
  'JavaScript',
  'Python',
  'C',
  'SQL',
  'Bash',
  'Java (Basic)',
  'Rust (Basic)',
];

const automationTools = [
  'Playwright',
  'Puppeteer',
  'Selenium WebDriver',
  'Appium',
  'k6',
  'JMeter',
  'SuperTest',
  'Requests',
];

const infrastructureTools = ['Docker', 'Kubernetes', 'GitHub Actions', 'Linux', 'Allure', 'Git'];
---

<BaseLayout
  title="About | Senior SDET & Quality Engineering Architect"
  description="Professional background, 8 years of quality engineering experience, verified career metrics, automation architecture philosophy, and technical competencies."
>
  <div class="about-page">
    <div class="container">
      <header class="page-header">
        <span class="page-kicker">Professional Background</span>
        <h1 class="page-title">Engineering Mindset &amp; Experience</h1>
        <p class="page-lead">
          Senior Software Development Engineer in Test (SDET) with <strong
            >{profile.experienceYears} years of dedicated experience</strong
          >
          designing, implementing, and stabilizing quality engineering systems across high-growth product
          teams.
        </p>
      </header>

      <div class="about-grid">
        <!-- Main Narrative Column -->
        <div class="about-content">
          <section class="about-section">
            <h2 class="section-title">Professional Overview</h2>
            <p>
              Over the past eight years, my focus has centered on solving the hardest problems in
              software testing:
              <strong>architectural maintainability, execution speed, and test determinism</strong>.
            </p>
            <p>
              Rather than viewing automation as merely translating manual test cases into scripts, I
              treat test frameworks as critical production software products. A poorly architected
              test suite creates drag on delivery velocity; a well-architected framework acts as a
              force multiplier that empowers engineering teams to deploy to production with absolute
              confidence multiple times a day.
            </p>
          </section>

          <!-- Verified Career Metrics Inventory -->
          <section class="about-section">
            <h2 class="section-title">Verified Testing Portfolio &amp; Career Metrics</h2>
            <p>
              Across eight years of dedicated quality engineering, I operate with an evidence-based
              approach to testing. All figures below represent aggregated, verifiable data from
              enterprise and commercial delivery environments:
            </p>

            <div class="metrics-summary-cards">
              <div class="summary-mini-card">
                <span class="mini-card-number">{profile.metrics.totalTestsHandled}</span>
                <span class="mini-card-label">Test Cases Handled</span>
                <span class="mini-card-sub">Across 8-year SDET career</span>
              </div>
              <div class="summary-mini-card">
                <span class="mini-card-number">{profile.metrics.automatedTests}</span>
                <span class="mini-card-label">Automated Tests</span>
                <span class="mini-card-sub"
                  >{profile.metrics.automationShare} lifetime automation share</span
                >
              </div>
              <div class="summary-mini-card">
                <span class="mini-card-number">{profile.metrics.frameworksCount}</span>
                <span class="mini-card-label">Custom Frameworks</span>
                <span class="mini-card-sub">Architected from the ground up</span>
              </div>
              <div class="summary-mini-card">
                <span class="mini-card-number">{profile.metrics.regressionReduction}</span>
                <span class="mini-card-label">Regression Cycle Cut</span>
                <span class="mini-card-sub"
                  >{profile.metrics.regressionManualTime} to {
                    profile.metrics.regressionAutomatedTime
                  }</span
                >
              </div>
            </div>

            <h3 class="subsection-title">
              Automation by Framework ({profile.metrics.automatedTests} Tests)
            </h3>
            <div class="breakdown-table-wrapper">
              <table class="metrics-table">
                <thead>
                  <tr>
                    <th>Framework</th>
                    <th>Automated Tests</th>
                    <th>Share of Automated Total</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    profile.metrics.frameworkBreakdown.map((f) => (
                      <tr>
                        <td class="font-medium">{f.name}</td>
                        <td>{f.count}</td>
                        <td class="font-mono text-accent">{f.share}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <h3 class="subsection-title">
              Testing Portfolio by Category ({profile.metrics.totalTestsHandled} Total Cases)
            </h3>
            <div class="breakdown-table-wrapper">
              <table class="metrics-table">
                <thead>
                  <tr>
                    <th>Testing Category</th>
                    <th>Test Cases</th>
                    <th>Share of Total</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    profile.metrics.categoryBreakdown.map((c) => (
                      <tr>
                        <td class="font-medium">{c.category}</td>
                        <td>{c.count}</td>
                        <td class="font-mono text-accent">{c.share}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <h3 class="subsection-title">Quantified Delivery &amp; Reliability Impact</h3>
            <ul class="impact-list">
              <li>
                <strong>Regression Compression:</strong> Reduced manual regression cycles from approximately
                3 days (24 standard working hours) to 2.5 automated hours—yielding an <strong
                  >{profile.metrics.regressionReduction} reduction in execution time</strong
                > and an overall <strong
                  >{profile.metrics.regressionSpeedup} speed improvement</strong
                >.
              </li>
              <li>
                <strong>Coverage Expansion:</strong> Scaled project-specific automation coverage from
                <strong>{profile.metrics.coverageStart} to {profile.metrics.coverageEnd}</strong> ({
                  profile.metrics.coverageImprovement
                } percentage points), drastically reducing escaped defects in production.
              </li>
              <li>
                <strong>Defect Mitigation:</strong> Identified and isolated between <strong
                  >{profile.metrics.defectsIdentified} defects</strong
                > pre-production, protecting customer trust and platform availability.
              </li>
              <li>
                <strong>High-Velocity Delivery:</strong> Maintained regression stability in environments
                merging <strong>{profile.metrics.dailyPrMerges}</strong> across cross-functional engineering
                teams of {profile.metrics.teamSize}, including mission-critical fintech SaaS systems
                featured on <em>Shark Tank India (Season 5)</em>.
              </li>
            </ul>
          </section>

          <section class="about-section">
            <h2 class="section-title">Approach to Automation Architecture</h2>
            <p>My architectural philosophy is anchored on three non-negotiable principles:</p>
            <ul class="principles-list">
              <li>
                <strong>Strict Test Isolation:</strong> Every automated scenario must generate its own
                test state via API or factory fixtures and clean up after itself. Shared mutable database
                state is the primary cause of intermittent pipeline failures.
              </li>
              <li>
                <strong>Zero Tolerance for Blind Retries:</strong> Configuring test runners to retry failing
                tests masks underlying race conditions and degrades pipeline trust. I systematically investigate
                failures to isolate whether the defect lies in element synchronization, unhandled asynchronous
                network traffic, or frontend hydration timing.
              </li>
              <li>
                <strong>Component Object Abstraction:</strong> Decoupling element locators from test logic
                ensures that when a frontend design system is updated, only a single component object
                is modified—preventing cascading breaks across dozens of test files.
              </li>
            </ul>
          </section>

          <section class="about-section">
            <h2 class="section-title">Collaboration with Cross-Functional Teams</h2>
            <p>
              Quality engineering is most effective when integrated directly into the software
              development lifecycle rather than acting as a downstream bottleneck. I regularly
              collaborate with:
            </p>
            <ul class="collaboration-list">
              <li>
                <strong>Frontend &amp; Backend Engineers:</strong> Defining testability hooks (`data-testid`),
                establishing API contract schemas with Zod, and shifting verification left into pre-commit
                and PR workflows.
              </li>
              <li>
                <strong>DevOps &amp; Infrastructure Engineers:</strong> Containerizing test runners in
                Docker, setting up parallel test sharding in GitHub Actions, and optimizing pipeline runtimes
                to deliver actionable feedback in under 5 minutes.
              </li>
              <li>
                <strong>Product Managers:</strong> Conducting risk-based testing analyses to ensure automation
                effort is directed where user impact and business risk are highest.
              </li>
            </ul>
          </section>
        </div>

        <!-- Sidebar / Technical Inventory -->
        <aside class="about-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-heading">Core Competencies</h3>
            <ul class="competencies-list">
              {coreCompetencies.map((comp) => <li>{comp}</li>)}
            </ul>
          </div>

          <div class="sidebar-card">
            <h3 class="sidebar-heading">Technology Inventory</h3>

            <div class="tech-group">
              <span class="tech-group-title">Languages</span>
              <div class="tags-row">
                {technicalLanguages.map((t) => <TechTag label={t} variant="accent" />)}
              </div>
            </div>

            <div class="tech-group">
              <span class="tech-group-title">Automation Frameworks</span>
              <div class="tags-row">
                {automationTools.map((t) => <TechTag label={t} variant="default" />)}
              </div>
            </div>

            <div class="tech-group">
              <span class="tech-group-title">Infrastructure &amp; Tooling</span>
              <div class="tags-row">
                {infrastructureTools.map((t) => <TechTag label={t} variant="default" />)}
              </div>
            </div>
          </div>

          <div class="sidebar-card resume-card">
            <h3 class="sidebar-heading">Curriculum Vitae</h3>
            <p class="resume-text">
              Download Satyam Tiwari's verified curriculum vitae detailing career milestones and
              commercial engagements.
            </p>
            <a
              href={profile.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Resume (PDF)</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .page-header {
    max-width: 800px;
    margin-bottom: var(--space-12);
  }

  .page-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about-section {
    line-height: var(--leading-relaxed);
  }

  .section-title {
    font-size: var(--text-2xl);
    margin-top: 0;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .subsection-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .about-section p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  /* Metrics Summary Mini Cards */
  .metrics-summary-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 600px) {
    .metrics-summary-cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .summary-mini-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mini-card-number {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent-primary);
    line-height: var(--leading-tight);
  }

  .mini-card-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .mini-card-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-tight);
  }

  /* Metrics Tables */
  .breakdown-table-wrapper {
    overflow-x: auto;
    margin-bottom: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
  }

  .metrics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    text-align: left;
  }

  .metrics-table th,
  .metrics-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .metrics-table th {
    background-color: var(--bg-surface-elevated);
    color: var(--text-primary);
    font-weight: 600;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .metrics-table tbody tr:last-child td {
    border-bottom: none;
  }

  .font-medium {
    font-weight: 600;
    color: var(--text-primary);
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .text-accent {
    color: var(--accent-primary);
    font-weight: 600;
  }

  /* Impact & Principles Lists */
  .impact-list,
  .principles-list,
  .collaboration-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .impact-list li,
  .principles-list li,
  .collaboration-list li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    position: relative;
    padding-left: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .impact-list li::before,
  .principles-list li::before,
  .collaboration-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1;
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .sidebar-heading {
    font-size: var(--text-base);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .competencies-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .competencies-list li {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    position: relative;
    padding-left: var(--space-3);
  }

  .competencies-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--status-success);
    font-size: var(--text-xs);
  }

  .tech-group {
    margin-bottom: var(--space-4);
  }

  .tech-group:last-child {
    margin-bottom: 0;
  }

  .tech-group-title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .resume-card {
    border-left: 3px solid var(--accent-primary);
  }

  .resume-text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: var(--text-inverse);
    border: 1px solid var(--accent-primary);
  }

  .btn-primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    text-decoration: none;
  }
</style>
