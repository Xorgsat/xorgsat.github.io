---
// src/pages/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import ExperienceHighlights from '@components/home/ExperienceHighlights.astro';
import TestExecutionTerminal from '@components/home/TestExecutionTerminal.astro';
import FeaturedProjects from '@components/home/FeaturedProjects.astro';
import SystemArchitectureSection from '@components/home/SystemArchitectureSection.astro';
import MethodologySection from '@components/home/MethodologySection.astro';
import ContactCta from '@components/home/ContactCta.astro';

const pageTitle = 'Senior SDET & Quality Engineering Architect';
const pageDescription =
  'Designing scalable test systems, automation frameworks and quality strategies for high-throughput, distributed products. 8 years engineering resilient test automation systems across UI, API, mobile, and CI/CD pipelines.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Section 2: Hero -->
  <HeroSection />

  <!-- Section 3: Engineering Metrics -->
  <ExperienceHighlights />

  <!-- Section 4: Test Execution Environment -->
  <TestExecutionTerminal />

  <!-- Section 5: Featured Case Studies -->
  <FeaturedProjects />

  <!-- Section 6: Engineering Architecture -->
  <SystemArchitectureSection />

  <!-- Section 7: Engineering Methodology -->
  <MethodologySection />

  <!-- Section 8: Contact -->
  <ContactCta />
</BaseLayout>
