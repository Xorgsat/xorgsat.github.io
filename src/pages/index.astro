---
// src/pages/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import ExperienceHighlights from '@components/home/ExperienceHighlights.astro';
import CapabilitiesSection from '@components/home/CapabilitiesSection.astro';
import FeaturedProjects from '@components/home/FeaturedProjects.astro';
import PhilosophySection from '@components/home/PhilosophySection.astro';
import ContactCta from '@components/home/ContactCta.astro';

const pageTitle = 'Senior SDET & Quality Engineering Architect';
const pageDescription =
  '8 years of experience engineering reliable automation systems across UI, API, mobile, and CI/CD pipelines. Portfolio of 12 test frameworks and architectural case studies.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <HeroSection />
  <ExperienceHighlights />
  <CapabilitiesSection />
  <FeaturedProjects />
  <PhilosophySection />
  <ContactCta />
</BaseLayout>
