---
// src/pages/projects/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// Sort by order defined in frontmatter
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Helper to derive clean slug from id (e.g., '01-banking-quality-engineering' -> 'banking-quality-engineering')
function getProjectSlug(id: string): string {
  return id.replace(/^\d+-/, '').replace(/\.md$/, '');
}

function getSchematicType(slug: string): string {
  if (slug.includes('banking')) return 'banking';
  if (slug.includes('hrm')) return 'hrm';
  if (slug.includes('playwright') || slug.includes('brel')) return 'playwright';
  if (slug.includes('performance') || slug.includes('pizza')) return 'performance';
  if (slug.includes('mobile')) return 'mobile';
  if (slug.includes('cicd') || slug.includes('platform')) return 'cicd';
  return 'api';
}

const categories = [
  'All',
  'UI & E2E Automation',
  'API & Backend Quality',
  'Mobile Automation',
  'Performance Engineering',
  'Test Infrastructure',
  'Enterprise Systems',
  'Commercial Project',
];
---

<BaseLayout
  title="Projects Directory | 12 Test Automation Frameworks"
  description="Explore 12 quality engineering and test automation frameworks across UI, API, Mobile, Performance, and CI/CD test infrastructure."
>
  <div class="projects-page blueprint-grid">
    <div class="container">
      <!-- Page Header -->
      <header class="page-header">
        <span class="eyebrow">ARCHITECTURAL BLUEPRINTS // 12 REPOSITORIES</span>
        <h1 class="display-title page-title">
          Engineering Projects &amp; Frameworks<span class="accent-text">.</span>
        </h1>
        <p class="page-description">
          A catalog of 12 test automation frameworks and quality engineering systems. Includes 8
          purpose-built demonstration architectures and 4 commercial enterprise case studies across
          UI, API, Mobile, Performance, and CI/CD gates.
        </p>
      </header>

      <!-- Category Filter Controls -->
      <div class="filter-wrapper" role="toolbar" aria-label="Project Category Filters">
        <div class="filter-header">
          <span class="filter-label mono text-xs">FILTER BY DOMAIN:</span>
          <span class="mono text-xs text-dim" id="filter-count">SHOWING: 12 OF 12</span>
        </div>
        <div class="filter-buttons">
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class:list={['filter-btn mono', { active: index === 0 }]}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="projects-grid" id="projects-grid">
        {
          sortedProjects.map((project, idx) => {
            const slug = getProjectSlug(project.id);
            const sheetId = String(idx + 1).padStart(2, '0');

            return (
              <article
                class="project-card blueprint-frame"
                data-category={project.data.category}
                data-status={project.data.status}
              >
                {/* Top Technical Bar */}
                <div class="card-tech-bar">
                  <span class="mono text-xs text-blue">
                    DWG-{sheetId} // {project.data.projectType.toUpperCase()}
                  </span>
                  <span class="card-status-badge">
                    <span class="status-indicator-dot" aria-hidden="true" />
                    <span>{project.data.status}</span>
                  </span>
                </div>

                {/* Technical Blueprint Schematic Banner */}
                <div class="card-schematic-banner" aria-hidden="true">
                  {getSchematicType(slug) === 'banking' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        TX INGRESS
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        INVARIANT
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        LEDGER DB
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'hrm' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        EMPLOYEE
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        STATE MACH
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        RBAC GATE
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'playwright' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        6 WORKERS
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        AUTO-WAIT
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        HERMETIC
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'performance' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <path
                        d="M 20 55 Q 80 15 160 35 T 300 20"
                        fill="none"
                        stroke="var(--lime)"
                        stroke-width="1.8"
                      />
                      <line
                        x1="20"
                        y1="55"
                        x2="300"
                        y2="55"
                        stroke="var(--border-strong)"
                        stroke-width="1"
                      />
                      <text
                        x="50"
                        y="30"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        font-weight="700"
                      >
                        5k VUs
                      </text>
                      <text
                        x="270"
                        y="30"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="end"
                        font-weight="700"
                      >
                        p99 &lt; 180ms
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'mobile' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        DEVICE FARM
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        APPIUM 2.X
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        MOCK SENSORS
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'cicd' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        GIT PR MERGE
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        PR GATE &lt;5M
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        PROD DEPLOY
                      </text>
                    </svg>
                  )}

                  {getSchematicType(slug) === 'api' && (
                    <svg viewBox="0 0 320 70" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="35"
                        x2="300"
                        y2="35"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      <rect
                        x="20"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="52"
                        y="39"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        OPENAPI 3.1
                      </text>
                      <polygon
                        points="160,14 195,35 160,56 125,35"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="160"
                        y="38"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="7.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        SCHEMA DIFF
                      </text>
                      <rect
                        x="235"
                        y="16"
                        width="65"
                        height="38"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <text
                        x="267"
                        y="39"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        WIREMOCK
                      </text>
                    </svg>
                  )}
                </div>

                <div class="card-inner-body">
                  <span class="project-category">{project.data.category}</span>

                  <h2 class="project-title">
                    <a href={`/projects/${slug}`}>{project.data.title}</a>
                  </h2>

                  <p class="project-description">{project.data.description}</p>

                  <div class="card-focus-block">
                    <span class="focus-title mono text-xs">ENGINEERING FOCUS:</span>
                    <p class="focus-text">{project.data.engineeringFocus}</p>
                  </div>

                  <div class="card-tech">
                    {project.data.techStack.map((tech) => (
                      <TechTag label={tech} variant="default" />
                    ))}
                  </div>

                  <div class="card-footer">
                    <a href={`/projects/${slug}`} class="case-study-link">
                      <span>Inspect Case Study</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>

                    <a
                      href={project.data.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="repo-link"
                      title={`View repository for ${project.data.title}`}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                      </svg>
                      <span>Repository</span>
                      <span class="sr-only"> (opens in new tab)</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- No Results Message -->
      <div id="no-results-msg" class="no-results blueprint-frame" hidden>
        <p class="mono text-sm muted m-0">No projects match the selected domain category filter.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .page-header {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .page-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Filters */
  .filter-wrapper {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .filter-label {
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.08em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background-color: var(--surface-soft);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .filter-btn:hover {
    border-color: var(--blue);
    color: var(--text);
  }

  .filter-btn.active {
    background-color: var(--blue);
    border-color: var(--blue);
    color: #ffffff;
    font-weight: 700;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 800px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration-fast),
      transform var(--duration-fast),
      box-shadow var(--duration-fast);
  }

  .project-card:hover {
    border-color: var(--blue);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px var(--grid-glow);
  }

  .project-card[hidden] {
    display: none !important;
  }

  .card-tech-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background-color: var(--surface-soft);
    border-bottom: 1px dashed var(--border);
  }

  .card-schematic-banner {
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 8px 12px;
  }

  .card-svg {
    width: 100%;
    height: 56px;
    display: block;
  }

  .card-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime);
  }

  .card-inner-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .project-title {
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .project-title a:hover {
    color: var(--blue);
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-4) 0;
  }

  .card-focus-block {
    background-color: var(--surface-soft);
    border-left: 3px solid var(--blue);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .focus-title {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 2px;
  }

  .focus-text {
    font-size: var(--text-xs);
    color: var(--text);
    margin: 0;
    line-height: var(--leading-normal);
    font-weight: 500;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    margin-bottom: var(--space-5);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border);
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--lime);
    text-decoration: none;
    transition: transform var(--duration-fast);
  }

  .case-study-link:hover {
    transform: translateX(3px);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .repo-link:hover {
    color: var(--blue);
  }

  .no-results {
    padding: var(--space-8);
    text-align: center;
    background-color: var(--surface);
    margin-top: var(--space-6);
  }

  .text-blue {
    color: var(--blue);
  }
  .text-dim {
    color: var(--text-dim);
  }
  .m-0 {
    margin: 0;
  }
</style>

<script is:inline>
  function setupProjectFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    const noResultsMsg = document.getElementById('no-results-msg');
    const filterCountEl = document.getElementById('filter-count');

    if (!filterButtons.length || !projectCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCategory = btn.getAttribute('data-category');
        let visibleCount = 0;

        projectCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'All' || cardCategory === selectedCategory) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (filterCountEl) {
          filterCountEl.textContent = `SHOWING: ${visibleCount} OF ${projectCards.length}`;
        }

        if (noResultsMsg) {
          if (visibleCount === 0) {
            noResultsMsg.removeAttribute('hidden');
          } else {
            noResultsMsg.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
