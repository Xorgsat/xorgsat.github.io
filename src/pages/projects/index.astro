---
// src/pages/projects/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// Sort by order defined in frontmatter
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Helper to derive clean slug from id (e.g., '01-banking-quality-engineering' -> 'banking-quality-engineering')
function getProjectSlug(id: string): string {
  return id.replace(/^\d+-/, '').replace(/\.md$/, '');
}

const categories = [
  'All',
  'UI & E2E Automation',
  'API & Backend Quality',
  'Mobile Automation',
  'Performance Engineering',
  'Test Infrastructure',
  'Enterprise Systems',
  'Commercial Project',
];
---

<BaseLayout
  title="Projects Directory | 12 Test Automation Frameworks"
  description="Explore 12 quality engineering and test automation frameworks across UI, API, Mobile, Performance, and CI/CD test infrastructure."
>
  <div class="projects-page">
    <div class="container">
      <header class="page-header">
        <span class="page-kicker">Architecture Portfolio</span>
        <h1 class="page-title">Engineering Projects &amp; Frameworks</h1>
        <p class="page-description">
          A comprehensive catalog of 12 test automation frameworks and quality engineering systems.
          Includes 8 purpose-built demonstration frameworks and 4 commercial enterprise case
          studies.
        </p>
      </header>

      <!-- Category Filter Controls -->
      <div class="filter-wrapper" role="toolbar" aria-label="Project Category Filters">
        <span class="filter-label">Filter by Domain:</span>
        <div class="filter-buttons">
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class:list={['filter-btn', { active: index === 0 }]}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="projects-grid" id="projects-grid">
        {
          sortedProjects.map((project) => {
            const slug = getProjectSlug(project.id);
            return (
              <article
                class="project-card"
                data-category={project.data.category}
                data-status={project.data.status}
              >
                <div class="card-header">
                  <span class="project-category">{project.data.category}</span>
                  <span
                    class:list={[
                      'status-pill',
                      project.data.status.toLowerCase().replace(/\s+/g, '-'),
                    ]}
                  >
                    {project.data.status}
                  </span>
                </div>

                <h2 class="project-title">
                  <a href={`/projects/${slug}`}>{project.data.title}</a>
                </h2>

                <p class="project-description">{project.data.description}</p>

                <div class="card-focus-block">
                  <span class="focus-title">Engineering Focus:</span>
                  <p class="focus-text">{project.data.engineeringFocus}</p>
                </div>

                <div class="card-tech">
                  {project.data.techStack.map((tech) => (
                    <TechTag label={tech} variant="default" />
                  ))}
                </div>

                <div class="card-footer">
                  <a href={`/projects/${slug}`} class="case-study-link">
                    <span>Inspect Case Study</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>

                  <a
                    href={project.data.repositoryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="repo-link"
                    title={`View repository for ${project.data.title}`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </svg>
                    <span>Code</span>
                    <span class="sr-only"> (opens in new tab)</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- No Results Message -->
      <div id="no-results-msg" class="no-results" hidden>
        <p>No projects match the selected category filter.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .page-header {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .page-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Filters */
  .filter-wrapper {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--text-inverse);
    font-weight: 600;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--border-default);
  }

  .project-card[hidden] {
    display: none !important;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .status-pill.completed {
    background-color: var(--status-success-bg);
    color: var(--status-success);
    border: 1px solid color-mix(in srgb, var(--status-success) 30%, transparent);
  }

  .status-pill.in-development {
    background-color: var(--status-warning-bg);
    color: var(--status-warning);
    border: 1px solid color-mix(in srgb, var(--status-warning) 30%, transparent);
  }

  .project-title {
    font-size: var(--text-xl);
    margin-top: 0;
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  .project-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-title a:hover {
    color: var(--accent-primary);
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .card-focus-block {
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    background-color: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .focus-title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .focus-text {
    font-size: var(--text-xs);
    color: var(--text-primary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .case-study-link:hover {
    text-decoration: underline;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--bg-code);
  }

  .repo-link:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
  }

  .no-results {
    padding: var(--space-12);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-base);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script is:inline>
  function setupProjectFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    const noResults = document.getElementById('no-results-msg');

    if (!buttons.length || !cards.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'All' || cardCategory === category) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.removeAttribute('hidden');
          } else {
            noResults.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
