---
// src/pages/engineering-notes/[slug].astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allNotes = await getCollection('engineering-notes');
  const publishedNotes = allNotes.filter((note) => !note.data.draft);

  function getArticleSlug(id: string): string {
    return id.replace(/^\d+-/, '').replace(/\.md$/, '');
  }

  return publishedNotes.map((note) => ({
    params: { slug: getArticleSlug(note.id) },
    props: { article: note },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={`${article.data.title} | Engineering Notes`}
  description={article.data.summary}
  schemaType="Article"
  publishDate={article.data.publishDate}
>
  <div class="article-page blueprint-grid">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/engineering-notes" class="back-link mono">&larr; Back to Engineering Notes</a>
      </nav>

      <header class="article-header">
        <div class="header-badges">
          <span class="article-category mono text-xs">{article.data.category}</span>
          <span class="meta-dot" aria-hidden="true">&bull;</span>
          <time datetime={article.data.publishDate.toISOString()} class="article-date mono text-xs">
            {formatDate(article.data.publishDate)}
          </time>
        </div>

        <h1 class="display-title article-title">{article.data.title}</h1>
        <p class="article-lead">{article.data.summary}</p>

        <div class="article-tags">
          {article.data.tags.map((tag) => <TechTag label={tag} variant="accent" />)}
        </div>
      </header>

      <!-- Technical Memorandum Blueprint Header -->
      <div class="memo-blueprint-banner blueprint-frame">
        <div class="memo-banner-bar">
          <span class="mono text-xs text-blue">TECHNICAL MEMORANDUM &bull; SPECIFICATION SHEET</span
          >
          <span class="mono text-xs text-lime">REVIEWED &bull; PRODUCTION PROVEN</span>
        </div>
        <div class="memo-summary-grid">
          <div class="memo-grid-item">
            <span class="mono text-xs text-dim">DOMAIN TOPIC:</span>
            <span class="mono text-sm bold text-text">{article.data.category}</span>
          </div>
          <div class="memo-grid-item">
            <span class="mono text-xs text-dim">TARGET AUDIENCE:</span>
            <span class="mono text-sm bold text-text">Senior / Staff Engineers</span>
          </div>
          <div class="memo-grid-item">
            <span class="mono text-xs text-dim">CODE EXCERPTS:</span>
            <span class="mono text-sm bold text-lime">Production TypeScript / Python</span>
          </div>
          <div class="memo-grid-item">
            <span class="mono text-xs text-dim">CORE FOCUS:</span>
            <span class="mono text-sm bold text-blue">Determinism &amp; Reliability</span>
          </div>
        </div>
      </div>

      <!-- Rendered Article Markdown -->
      <article class="article-body prose">
        <Content />
      </article>

      <footer class="article-end-nav">
        <a href="/engineering-notes" class="btn btn-secondary">&larr; Back to All Articles</a>
        <a href="/contact" class="btn btn-primary">Discuss This Topic</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .back-link:hover {
    color: var(--lime);
    text-decoration: underline;
  }

  .article-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    max-width: var(--max-width-prose);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .article-category {
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-dot {
    color: var(--text-dim);
  }

  .article-date {
    color: var(--text-dim);
  }

  .article-title {
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: var(--text-4xl);
    }
  }

  .article-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Technical Memorandum Blueprint Banner */
  .memo-blueprint-banner {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
    overflow: hidden;
    max-width: var(--max-width-prose);
  }

  .memo-banner-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    background-color: var(--surface-soft);
    border-bottom: 1px dashed var(--border);
  }

  .memo-summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-6);
    padding: var(--space-4) var(--space-5);
  }

  @media (min-width: 600px) {
    .memo-summary-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .memo-grid-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .article-body {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-12);
  }

  .article-end-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    max-width: var(--max-width-prose);
  }
</style>
