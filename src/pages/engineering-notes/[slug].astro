---
// src/pages/engineering-notes/[slug].astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allNotes = await getCollection('engineering-notes');
  const publishedNotes = allNotes.filter((note) => !note.data.draft);

  function getArticleSlug(id: string): string {
    return id.replace(/^\d+-/, '').replace(/\.md$/, '');
  }

  return publishedNotes.map((note) => ({
    params: { slug: getArticleSlug(note.id) },
    props: { article: note },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={`${article.data.title} | Engineering Notes`}
  description={article.data.summary}
  schemaType="Article"
  publishDate={article.data.publishDate}
>
  <div class="article-page">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/engineering-notes" class="back-link">&larr; Back to Engineering Notes</a>
      </nav>

      <header class="article-header">
        <div class="header-badges">
          <span class="article-category">{article.data.category}</span>
          <span class="meta-dot" aria-hidden="true">&bull;</span>
          <time datetime={article.data.publishDate.toISOString()} class="article-date">
            {formatDate(article.data.publishDate)}
          </time>
        </div>

        <h1 class="article-title">{article.data.title}</h1>
        <p class="article-lead">{article.data.summary}</p>

        <div class="article-tags">
          {article.data.tags.map((tag) => <TechTag label={tag} variant="accent" />)}
        </div>
      </header>

      <!-- Rendered Article Markdown -->
      <article class="article-body prose">
        <Content />
      </article>

      <footer class="article-end-nav">
        <a href="/engineering-notes" class="btn btn-secondary">&larr; Back to All Articles</a>
        <a href="/contact" class="btn btn-primary">Discuss This Topic</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    max-width: var(--max-width-prose);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .article-category {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-top: 0;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: var(--text-4xl);
    }
  }

  .article-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Prose Article Body */
  .article-body {
    max-width: var(--max-width-prose);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .article-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-body :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-5);
    color: var(--text-secondary);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
    color: var(--text-secondary);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
    line-height: var(--leading-normal);
  }

  .article-end-nav {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
    margin-top: var(--space-12);
    max-width: var(--max-width-prose);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: var(--text-inverse);
    border: 1px solid var(--accent-primary);
  }

  .btn-primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    text-decoration: none;
  }

  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }

  .btn-secondary:hover {
    background-color: var(--bg-subtle);
    border-color: var(--text-secondary);
    text-decoration: none;
  }
</style>
