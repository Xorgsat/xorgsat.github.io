---
// src/pages/engineering-notes/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('engineering-notes');
// Filter out drafts and sort by publication date descending
const publishedNotes = allNotes
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

function getArticleSlug(id: string): string {
  return id.replace(/^\d+-/, '').replace(/\.md$/, '');
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const categories = ['All', 'Automation Architecture', 'Test Reliability', 'API Quality'];
---

<BaseLayout
  title="Engineering Notes | SDET Quality & Architecture Insights"
  description="Technical articles and architecture notes on test automation design, flaky test mitigation, API contract validation, and CI/CD quality engineering."
>
  <div class="notes-page">
    <div class="container">
      <header class="page-header">
        <span class="page-kicker">Technical Publications</span>
        <h1 class="page-title">Engineering Notes</h1>
        <p class="page-description">
          In-depth architectural analyses, debugging methodologies, and practical quality
          engineering guidance drawn from eight years of building production test systems.
        </p>
      </header>

      <!-- Category Filter -->
      <div class="filter-wrapper" role="toolbar" aria-label="Article Category Filters">
        <span class="filter-label">Filter by Topic:</span>
        <div class="filter-buttons">
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class:list={['filter-btn', { active: index === 0 }]}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Articles List -->
      <div class="articles-list" id="articles-list">
        {
          publishedNotes.map((article) => {
            const slug = getArticleSlug(article.id);
            return (
              <article class="article-card" data-category={article.data.category}>
                <div class="article-meta">
                  <span class="article-category">{article.data.category}</span>
                  <span class="meta-dot" aria-hidden="true">
                    &bull;
                  </span>
                  <time datetime={article.data.publishDate.toISOString()}>
                    {formatDate(article.data.publishDate)}
                  </time>
                </div>

                <h2 class="article-title">
                  <a href={`/engineering-notes/${slug}`}>{article.data.title}</a>
                </h2>

                <p class="article-summary">{article.data.summary}</p>

                <div class="article-footer">
                  <div class="article-tags">
                    {article.data.tags.map((tag) => (
                      <TechTag label={tag} variant="default" />
                    ))}
                  </div>

                  <a href={`/engineering-notes/${slug}`} class="read-link">
                    <span>Read Article</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- No Results Message -->
      <div id="no-results-msg" class="no-results" hidden>
        <p>No articles found for the selected topic.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notes-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .page-header {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .page-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Filters */
  .filter-wrapper {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--text-inverse);
    font-weight: 600;
  }

  /* Articles List */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 860px;
  }

  .article-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast);
  }

  .article-card:hover {
    border-color: var(--border-default);
  }

  .article-card[hidden] {
    display: none !important;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .article-category {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-title {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .article-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-title a:hover {
    color: var(--accent-primary);
  }

  .article-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }

  .no-results {
    padding: var(--space-12);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-base);
  }
</style>

<script is:inline>
  function setupArticleFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const articles = document.querySelectorAll('.article-card');
    const noResults = document.getElementById('no-results-msg');

    if (!buttons.length || !articles.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let visibleCount = 0;
        articles.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'All' || cardCategory === category) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.removeAttribute('hidden');
          } else {
            noResults.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupArticleFilters();
  document.addEventListener('astro:after-swap', setupArticleFilters);
</script>
