---
// src/pages/engineering-notes/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import TechTag from '@components/ui/TechTag.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('engineering-notes');
// Filter out drafts and sort by publication date descending
const publishedNotes = allNotes
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

function getArticleSlug(id: string): string {
  return id.replace(/^\d+-/, '').replace(/\.md$/, '');
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const categories = ['All', 'Automation Architecture', 'Test Reliability', 'API Quality'];
---

<BaseLayout
  title="Engineering Notes | SDET Quality & Architecture Insights"
  description="Technical articles and architecture notes on test automation design, flaky test mitigation, API contract validation, and CI/CD quality engineering."
>
  <div class="notes-page blueprint-grid">
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">TECHNICAL DISPATCHES // ARCHITECTURE MEMOS</span>
        <h1 class="display-title page-title">
          Engineering Notes &amp; Publications<span class="accent-text">.</span>
        </h1>
        <p class="page-description">
          In-depth architectural analyses, debugging methodologies, and practical quality
          engineering guidance drawn from eight years of building production test systems.
        </p>
      </header>

      <!-- Category Filter -->
      <div class="filter-wrapper" role="toolbar" aria-label="Article Category Filters">
        <span class="filter-label mono text-xs">FILTER BY TOPIC:</span>
        <div class="filter-buttons">
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class:list={['filter-btn mono', { active: index === 0 }]}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Articles List -->
      <div class="articles-list" id="articles-list">
        {
          publishedNotes.map((article, idx) => {
            const slug = getArticleSlug(article.id);
            const memoId = String(idx + 1).padStart(2, '0');

            return (
              <article class="article-card blueprint-frame" data-category={article.data.category}>
                <div class="article-tech-bar">
                  <span class="mono text-xs text-blue">
                    MEMO-0{memoId} // {article.data.category.toUpperCase()}
                  </span>
                  <time
                    datetime={article.data.publishDate.toISOString()}
                    class="mono text-xs text-dim"
                  >
                    {formatDate(article.data.publishDate)}
                  </time>
                </div>

                <div class="article-body">
                  <h2 class="article-title">
                    <a href={`/engineering-notes/${slug}`}>{article.data.title}</a>
                  </h2>

                  <p class="article-summary">{article.data.summary}</p>

                  <div class="article-footer">
                    <div class="article-tags">
                      {article.data.tags.map((tag) => (
                        <TechTag label={tag} variant="default" />
                      ))}
                    </div>

                    <a href={`/engineering-notes/${slug}`} class="read-link">
                      <span>Read Publication</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- No Results Message -->
      <div id="no-notes-msg" class="no-results blueprint-frame" hidden>
        <p class="mono text-sm muted m-0">
          No technical publications found for this category filter.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notes-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .page-header {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .page-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Filter */
  .filter-wrapper {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .filter-label {
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.08em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background-color: var(--surface-soft);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .filter-btn:hover {
    border-color: var(--blue);
    color: var(--text);
  }

  .filter-btn.active {
    background-color: var(--blue);
    border-color: var(--blue);
    color: var(--bg);
    font-weight: 700;
  }

  /* Articles List */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .article-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration-fast),
      transform var(--duration-fast),
      box-shadow var(--duration-fast);
  }

  .article-card:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px var(--grid-glow);
  }

  .article-card[hidden] {
    display: none !important;
  }

  .article-tech-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 18px;
    background-color: var(--surface-soft);
    border-bottom: 1px dashed var(--border);
  }

  .article-body {
    padding: var(--space-6);
  }

  .article-title {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
  }

  .article-title a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .article-title a:hover {
    color: var(--blue);
  }

  .article-summary {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-5) 0;
  }

  .article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--lime);
    text-decoration: none;
    transition: transform var(--duration-fast);
  }

  .read-link:hover {
    transform: translateX(3px);
  }

  .no-results {
    padding: var(--space-8);
    text-align: center;
    background-color: var(--surface);
    margin-top: var(--space-6);
  }

  .text-blue {
    color: var(--blue);
  }
  .text-dim {
    color: var(--text-dim);
  }
  .m-0 {
    margin: 0;
  }
</style>

<script is:inline>
  function setupArticleFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const articleCards = document.querySelectorAll('.article-card');
    const noNotesMsg = document.getElementById('no-notes-msg');

    if (!filterButtons.length || !articleCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCategory = btn.getAttribute('data-category');
        let visibleCount = 0;

        articleCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'All' || cardCategory === selectedCategory) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (noNotesMsg) {
          if (visibleCount === 0) {
            noNotesMsg.removeAttribute('hidden');
          } else {
            noNotesMsg.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupArticleFilters();
  document.addEventListener('astro:after-swap', setupArticleFilters);
</script>
