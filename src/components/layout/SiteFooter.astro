---
// src/components/layout/SiteFooter.astro
import { profile } from '../../config/profile';

const currentYear = new Date().getFullYear();

const professionalLinks = [
  { label: 'GitHub (Xorgsat)', href: profile.githubUrl, external: true },
  { label: 'LinkedIn', href: profile.linkedinUrl, external: true },
  { label: 'Email Inquiries', href: `mailto:${profile.email}`, external: false },
  { label: 'Resume PDF', href: profile.resumeUrl, external: true },
];
---

<footer class="site-footer">
  <div class="footer-blueprint-line" aria-hidden="true"></div>
  <div class="container footer-content">
    <div class="footer-primary">
      <div class="footer-brand">
        <span class="mono text-xs text-blue">SYS-08 //</span>
        <span class="brand-title">
          Satyam<span class="brand-dot">.</span>Tiwari
        </span>
        <span class="brand-role-tag">SDET ARCHITECT</span>
      </div>
      <p class="footer-tagline">
        I engineer confidence into software. Specialized in test automation architecture,
        deterministic test isolation, flaky test elimination, and resilient CI/CD quality gate
        design for distributed systems.
      </p>
      <div class="status-indicator">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="mono text-xs text-muted"
          >Open for International Remote Roles &amp; Quality Consulting</span
        >
      </div>
    </div>

    <div class="footer-links-section">
      <div class="footer-nav-col">
        <span class="footer-heading mono text-xs">BLUEPRINT DIRECTORY</span>
        <ul class="footer-links-list">
          <li><a href="/">Home</a></li>
          <li><a href="/projects">12 Projects Directory</a></li>
          <li><a href="/engineering-notes">Engineering Notes</a></li>
          <li><a href="/about">About &amp; Career History</a></li>
          <li><a href="/contact">Contact &amp; Commission</a></li>
        </ul>
      </div>

      <div class="footer-nav-col">
        <span class="footer-heading mono text-xs">VERIFIED REPOSITORIES</span>
        <ul class="footer-links-list">
          {
            professionalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {link.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p class="copyright mono text-xs">
        &copy; {currentYear}
        {profile.name} &bull; Senior SDET &amp; Quality Engineering Architect.
      </p>
      <p class="accessibility-note mono text-xs">
        BLUEPRINT SYSTEM SPEC // WCAG 2.2 AA VERIFIED // ZERO EXTERNAL RUNTIME JS
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background-color: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    position: relative;
  }

  .footer-blueprint-line {
    height: 1px;
    width: 100%;
    background: repeating-linear-gradient(
      90deg,
      var(--border),
      var(--border) 6px,
      transparent 6px,
      transparent 12px
    );
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .brand-title {
    font-size: var(--text-base);
    font-weight: 750;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .brand-dot {
    color: var(--lime);
  }

  .brand-role-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--blue);
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .footer-tagline {
    max-width: 480px;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface-soft);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime);
    box-shadow: 0 0 6px var(--lime);
  }

  .footer-links-section {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .footer-heading {
    display: block;
    color: var(--blue);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .footer-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links-list a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-links-list a:hover {
    color: var(--lime);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    background-color: var(--surface-soft);
    padding: var(--space-4) 0;
  }

  .footer-bottom-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
  }

  @media (min-width: 768px) {
    .footer-bottom-container {
      flex-direction: row;
    }
  }

  .copyright,
  .accessibility-note {
    margin: 0;
    color: var(--text-muted);
  }

  .text-blue {
    color: var(--blue);
  }
</style>
