---
// src/components/layout/SiteHeader.astro
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../../config/profile';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering-notes', label: 'Engineering Notes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="SDET Satyam Tiwari Portfolio Home">
      <span class="brand-badge">SDET</span>
      <span class="brand-title">{profile.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          class="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          class="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile Navigation" hidden>
    <ul class="mobile-nav-list">
      {
        navItems.map((item) => {
          const isActive =
            item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={['mobile-nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(8px);
    background-color: color-mix(in srgb, var(--bg-primary) 92%, transparent);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 700;
  }

  .brand-badge {
    background-color: var(--bg-code);
    color: var(--accent-primary);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .brand-title {
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Mobile Nav Button */
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    cursor: pointer;
  }

  .mobile-menu-btn:hover {
    background-color: var(--bg-subtle);
  }

  .icon-close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* Mobile Nav Drawer */
  .mobile-nav {
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding: var(--space-4) 0;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-2) 0;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .mobile-nav-link.active {
    color: var(--accent-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
    .mobile-menu-btn {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        nav.setAttribute('hidden', '');
      } else {
        nav.removeAttribute('hidden');
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
