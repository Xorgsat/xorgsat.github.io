---
// src/components/layout/SiteHeader.astro
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/engineering-notes', label: 'Engineering Notes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-blueprint-line" aria-hidden="true"></div>
  <div class="container header-container">
    <!-- Brand / Wordmark -->
    <a href="/" class="brand-link">
      <span class="brand-coordinate" aria-hidden="true">SYS-08 //</span>
      <span class="brand-title">
        Satyam<span class="brand-dot">.</span>Tiwari
      </span>
      <span class="brand-role-tag">SDET ARCHITECT</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header Actions & Telemetry -->
    <div class="header-actions">
      <!-- Live Availability Indicator -->
      <a
        href="/contact"
        class="availability-pill"
        title="Current Status: Available for remote architecture roles & advisory"
      >
        <span class="status-beacon" aria-hidden="true"></span>
        <span class="availability-text">AVAILABLE FOR ROLES</span>
      </a>

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Menu Toggle Button (Preserved for Playwright E2E) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          class="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          class="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation (Preserved for Playwright E2E) -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile Navigation" hidden>
    <div class="container">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['mobile-nav-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="mobile-nav-marker" aria-hidden="true">
                    ›
                  </span>
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mobile-nav-footer">
        <span class="mono text-xs muted">SENIOR SDET &amp; QUALITY ARCHITECT &bull; 8 YRS</span>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-blueprint-line {
    height: 2px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--blue) 20%,
      var(--lime) 50%,
      var(--blue) 80%,
      transparent
    );
    opacity: 0.8;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-4);
  }

  /* Brand / Wordmark */
  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text);
  }

  .brand-coordinate {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--blue);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .brand-coordinate {
      display: inline-block;
    }
  }

  .brand-title {
    font-size: var(--text-base);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .brand-dot {
    color: var(--lime);
  }

  .brand-role-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--blue);
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: clamp(16px, 2.5vw, 32px);
  }

  .nav-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2) 0;
    position: relative;
    transition: color var(--duration-fast);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active,
  .nav-link[aria-current='page'] {
    color: var(--text);
    font-weight: 650;
  }

  .nav-link.active::after,
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--lime);
    box-shadow: 0 0 6px var(--lime);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Live Availability Pill */
  .availability-pill {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    transition:
      border-color var(--duration-fast),
      color var(--duration-fast);
  }

  .availability-pill:hover {
    border-color: var(--lime);
    color: var(--text);
  }

  .status-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--lime);
    box-shadow: 0 0 8px var(--lime);
    display: inline-block;
  }

  @media (min-width: 640px) {
    .availability-pill {
      display: inline-flex;
    }
  }

  /* Mobile Nav Button */
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .mobile-menu-btn:hover {
    border-color: var(--blue);
  }

  .icon-close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* Mobile Nav Drawer */
  .mobile-nav {
    border-top: 1px solid var(--border);
    background-color: var(--surface);
    padding: var(--space-4) 0 var(--space-6);
    box-shadow: var(--shadow-card);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-base);
    font-weight: 500;
    border-bottom: 1px dashed var(--border);
    transition:
      color var(--duration-fast),
      padding-left var(--duration-fast);
  }

  .mobile-nav-marker {
    color: var(--blue);
    font-family: var(--font-mono);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--text);
    padding-left: var(--space-3);
  }

  .mobile-nav-link.active .mobile-nav-marker {
    color: var(--lime);
  }

  .mobile-nav-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
    .mobile-menu-btn {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        nav.setAttribute('hidden', '');
      } else {
        nav.removeAttribute('hidden');
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
