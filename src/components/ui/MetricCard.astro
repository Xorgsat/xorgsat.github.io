---
// src/components/ui/MetricCard.astro
interface Props {
  value: string;
  label: string;
  context: string;
  verified?: boolean;
  channel?: string;
}

const { value, label, context, verified = true, channel = 'INSTRUMENT' } = Astro.props;
---

<div class="metric-card blueprint-frame">
  <div class="card-telemetry-bar">
    <span class="mono text-xs card-channel">{channel}</span>
    {
      verified && (
        <span class="metric-badge" title="Verified against professional track record">
          <span class="status-indicator-dot" aria-hidden="true" />
          <span>VERIFIED DATA</span>
        </span>
      )
    }
  </div>

  <div class="metric-readout">
    <span class="metric-value">{value}</span>
  </div>

  <h3 class="metric-label">{label}</h3>
  <p class="metric-context">{context}</p>

  <div class="metric-footer-calibration" aria-hidden="true">
    <span class="calibration-scale"></span>
    <span class="mono text-xs text-dim">CAL: OK</span>
  </div>
</div>

<style>
  .metric-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration-fast),
      transform var(--duration-fast),
      box-shadow var(--duration-fast);
  }

  .metric-card:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px var(--grid-glow);
  }

  .card-telemetry-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-channel {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--blue);
  }

  .metric-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--lime);
    background-color: color-mix(in srgb, var(--lime) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--lime) 30%, transparent);
    padding: 2px 7px;
    border-radius: var(--radius-sm);
  }

  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime);
    box-shadow: 0 0 6px var(--lime);
  }

  .metric-readout {
    margin-bottom: var(--space-2);
  }

  .metric-value {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 750;
    color: var(--text);
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: var(--text-base);
    font-weight: 650;
    color: var(--text);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.015em;
  }

  .metric-context {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .metric-footer-calibration {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .calibration-scale {
    width: 60px;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      var(--border-strong),
      var(--border-strong) 2px,
      transparent 2px,
      transparent 6px
    );
  }

  .text-dim {
    color: var(--text-dim);
    font-size: 0.65rem;
  }
</style>
