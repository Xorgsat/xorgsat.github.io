---
// src/components/ui/TechTag.astro
interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'success' | 'outline';
}

const { label, variant = 'default' } = Astro.props;
---

<span class:list={['tech-tag', variant]}>
  {label}
</span>

<style>
  .tech-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-code);
    color: var(--text-secondary);
    line-height: 1;
    white-space: nowrap;
  }

  .tech-tag.accent {
    border-color: color-mix(in srgb, var(--accent-primary) 35%, transparent);
    color: var(--accent-primary);
    background-color: var(--accent-subtle);
  }

  .tech-tag.success {
    border-color: color-mix(in srgb, var(--status-success) 35%, transparent);
    color: var(--status-success);
    background-color: var(--status-success-bg);
  }

  .tech-tag.outline {
    background-color: transparent;
    border-color: var(--border-default);
    color: var(--text-muted);
  }
</style>
