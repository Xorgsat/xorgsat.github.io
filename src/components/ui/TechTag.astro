---
// src/components/ui/TechTag.astro
interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'success' | 'outline';
}

const { label, variant = 'default' } = Astro.props;
---

<span class:list={['tech-tag', variant]}>
  {label}
</span>

<style>
  .tech-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background-color: var(--surface-soft);
    color: var(--text-muted);
    line-height: 1;
    white-space: nowrap;
    letter-spacing: 0.02em;
    transition:
      border-color var(--duration-fast),
      color var(--duration-fast);
  }

  .tech-tag:hover {
    border-color: var(--blue);
    color: var(--text);
  }

  .tech-tag.accent {
    border-color: color-mix(in srgb, var(--blue) 35%, transparent);
    color: var(--blue);
    background-color: color-mix(in srgb, var(--blue) 10%, transparent);
  }

  .tech-tag.success {
    border-color: color-mix(in srgb, var(--lime) 40%, transparent);
    color: var(--lime);
    background-color: color-mix(in srgb, var(--lime) 12%, transparent);
  }

  .tech-tag.outline {
    background-color: transparent;
    border-color: var(--border);
    color: var(--text-muted);
  }
</style>
