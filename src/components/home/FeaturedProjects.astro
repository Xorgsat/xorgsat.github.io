---
// src/components/home/FeaturedProjects.astro
import TechTag from '@components/ui/TechTag.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

function getProjectSlug(id: string): string {
  return id.replace(/^\d+-/, '').replace(/\.md$/, '');
}

// Generate distinct technical SVG schematics for each featured project
function getSchematicType(slug: string): string {
  if (slug.includes('banking')) return 'banking';
  if (slug.includes('playwright') || slug.includes('brel')) return 'brel';
  if (slug.includes('performance') || slug.includes('pizza')) return 'performance';
  return 'api';
}
---

<section class="featured-projects-section section" aria-labelledby="featured-heading">
  <div class="container">
    <div class="section-header">
      <div class="header-left">
        <span class="eyebrow">PRODUCTION CASE STUDIES // EVIDENCE-BASED</span>
        <h2 id="featured-heading" class="display-title section-title">
          Featured Engineering Projects<span class="accent-text">.</span>
        </h2>
        <p class="section-description">
          Detailed architectural case studies analyzing distributed failure modes, test isolation
          invariants, parallel execution harnesses, and measurable engineering outcomes.
        </p>
      </div>
      <div class="header-action">
        <a href="/projects" class="btn btn-secondary">
          <span>View All 12 Projects</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Featured Projects Grid -->
    <div class="projects-grid">
      {
        featuredProjects.map((project, idx) => {
          const slug = getProjectSlug(project.id);
          const schematicType = getSchematicType(slug);
          const sheetNum = String(idx + 1).padStart(2, '0');

          return (
            <article class="project-card blueprint-frame">
              {/* Technical Schematic Header Banner */}
              <div class="card-schematic-banner" aria-hidden="true">
                <div class="schematic-meta-bar">
                  <span class="mono text-xs text-blue">SCHEMATIC DWG-{sheetNum}</span>
                  <span class="mono text-xs text-dim">ISOMETRIC ARCHITECTURE</span>
                </div>

                <div class="schematic-canvas">
                  {schematicType === 'banking' && (
                    <svg viewBox="0 0 340 110" fill="none" class="card-svg">
                      <line
                        x1="20"
                        y1="55"
                        x2="320"
                        y2="55"
                        stroke="var(--border-strong)"
                        stroke-dasharray="3 3"
                      />
                      {/* Transaction Input Node */}
                      <rect
                        x="25"
                        y="35"
                        width="60"
                        height="40"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="55"
                        y="58"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        TX IN
                      </text>
                      {/* Invariant Engine */}
                      <polygon
                        points="170,25 215,55 170,85 125,55"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="170"
                        y="54"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        DOUBLE-ENTRY
                      </text>
                      <text
                        x="170"
                        y="65"
                        fill="var(--text-muted)"
                        font-family="var(--font-mono)"
                        font-size="7"
                        text-anchor="middle"
                      >
                        INVARIANTS
                      </text>
                      {/* Ledger State */}
                      <rect
                        x="255"
                        y="35"
                        width="65"
                        height="40"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--cyan)"
                        stroke-width="1.2"
                      />
                      <text
                        x="287"
                        y="58"
                        fill="var(--cyan)"
                        font-family="var(--font-mono)"
                        font-size="8.5"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        ACID LEDGER
                      </text>
                      {/* Arrows */}
                      <path d="M 85 55 L 125 55" stroke="var(--lime)" stroke-width="1.5" />
                      <path d="M 215 55 L 255 55" stroke="var(--cyan)" stroke-width="1.5" />
                    </svg>
                  )}

                  {schematicType === 'brel' && (
                    <svg viewBox="0 0 340 110" fill="none" class="card-svg">
                      {/* Dual Browser Workers Flow */}
                      <rect
                        x="20"
                        y="20"
                        width="75"
                        height="30"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="57"
                        y="38"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        CHROMIUM
                      </text>
                      <rect
                        x="20"
                        y="60"
                        width="75"
                        height="30"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--cyan)"
                        stroke-width="1.2"
                      />
                      <text
                        x="57"
                        y="78"
                        fill="var(--cyan)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        WEBKIT / FF
                      </text>
                      {/* Harness Controller */}
                      <rect
                        x="135"
                        y="30"
                        width="85"
                        height="50"
                        rx="6"
                        fill="var(--surface-raised)"
                        stroke="var(--lime)"
                        stroke-width="1.5"
                      />
                      <text
                        x="177"
                        y="52"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        BREL ENGINE
                      </text>
                      <text
                        x="177"
                        y="64"
                        fill="var(--text-muted)"
                        font-family="var(--font-mono)"
                        font-size="7"
                        text-anchor="middle"
                      >
                        DUAL HARNESS
                      </text>
                      {/* Telemetry Gate */}
                      <polygon
                        points="280,30 315,55 280,80 245,55"
                        fill="var(--surface)"
                        stroke="var(--blue)"
                        stroke-width="1.2"
                      />
                      <text
                        x="280"
                        y="58"
                        fill="var(--text)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        GATE OK
                      </text>
                      {/* Connecting lines */}
                      <path d="M 95 35 L 135 45" stroke="var(--border-strong)" stroke-width="1.2" />
                      <path d="M 95 75 L 135 65" stroke="var(--border-strong)" stroke-width="1.2" />
                      <path d="M 220 55 L 245 55" stroke="var(--lime)" stroke-width="1.5" />
                    </svg>
                  )}

                  {schematicType === 'performance' && (
                    <svg viewBox="0 0 340 110" fill="none" class="card-svg">
                      {/* Distributed Load Traffic */}
                      <path
                        d="M 20 85 Q 90 20 170 50 T 320 30"
                        fill="none"
                        stroke="var(--lime)"
                        stroke-width="1.8"
                      />
                      <line
                        x1="20"
                        y1="85"
                        x2="320"
                        y2="85"
                        stroke="var(--border-strong)"
                        stroke-width="1"
                      />
                      <line
                        x1="20"
                        y1="85"
                        x2="20"
                        y2="20"
                        stroke="var(--border-strong)"
                        stroke-width="1"
                      />
                      <circle cx="170" cy="50" r="4" fill="var(--blue)" />
                      <text
                        x="170"
                        y="38"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        p99 &lt; 180ms
                      </text>
                      <rect
                        x="230"
                        y="60"
                        width="80"
                        height="20"
                        rx="3"
                        fill="var(--surface)"
                        stroke="var(--border)"
                      />
                      <text
                        x="270"
                        y="73"
                        fill="var(--text-dim)"
                        font-family="var(--font-mono)"
                        font-size="7"
                        text-anchor="middle"
                      >
                        5,000 VUs BURST
                      </text>
                    </svg>
                  )}

                  {schematicType === 'api' && (
                    <svg viewBox="0 0 340 110" fill="none" class="card-svg">
                      <rect
                        x="30"
                        y="35"
                        width="70"
                        height="40"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--cyan)"
                        stroke-width="1.2"
                      />
                      <text
                        x="65"
                        y="58"
                        fill="var(--cyan)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        CLIENT API
                      </text>
                      <rect
                        x="140"
                        y="30"
                        width="80"
                        height="50"
                        rx="4"
                        fill="var(--surface-raised)"
                        stroke="var(--blue)"
                        stroke-width="1.5"
                      />
                      <text
                        x="180"
                        y="52"
                        fill="var(--blue)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        PACT SCHEMA
                      </text>
                      <text
                        x="180"
                        y="64"
                        fill="var(--text-muted)"
                        font-family="var(--font-mono)"
                        font-size="7"
                        text-anchor="middle"
                      >
                        VALIDATOR
                      </text>
                      <rect
                        x="250"
                        y="35"
                        width="65"
                        height="40"
                        rx="4"
                        fill="var(--surface)"
                        stroke="var(--lime)"
                        stroke-width="1.2"
                      />
                      <text
                        x="282"
                        y="58"
                        fill="var(--lime)"
                        font-family="var(--font-mono)"
                        font-size="8"
                        text-anchor="middle"
                        font-weight="700"
                      >
                        BACKEND
                      </text>
                      <path
                        d="M 100 55 L 140 55"
                        stroke="var(--border-strong)"
                        stroke-width="1.2"
                      />
                      <path d="M 220 55 L 250 55" stroke="var(--lime)" stroke-width="1.5" />
                    </svg>
                  )}
                </div>
              </div>

              {/* Card Body */}
              <div class="card-body">
                <div class="card-header">
                  <span class="project-category">{project.data.category}</span>
                  <span class="status-badge status-completed">
                    <span class="status-dot" />
                    <span>{project.data.status}</span>
                  </span>
                </div>

                <h3 class="project-title">
                  <a href={`/projects/${slug}`}>{project.data.title}</a>
                </h3>

                <div class="project-detail-block">
                  <span class="detail-label mono">PROBLEM STATEMENT:</span>
                  <p class="detail-text">{project.data.businessProblem}</p>
                </div>

                <div class="project-detail-block">
                  <span class="detail-label mono">ENGINEERING FOCUS:</span>
                  <p class="detail-text highlight">{project.data.engineeringFocus}</p>
                </div>

                {/* Tech Stack Badges */}
                <div class="card-tech">
                  {project.data.techStack.map((tech) => (
                    <TechTag label={tech} variant="default" />
                  ))}
                </div>

                {/* Card Action Footer */}
                <div class="card-footer">
                  <a href={`/projects/${slug}`} class="case-study-link">
                    <span>Read Full Case Study</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>

                  {project.data.repositoryUrl && (
                    <a
                      href={project.data.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="repo-link"
                      aria-label={`Inspect source repository for ${project.data.title}`}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                      </svg>
                      <span>Repository</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .featured-projects-section {
    background-color: var(--bg);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .header-left {
    max-width: 740px;
  }

  .section-title {
    margin-bottom: var(--space-2);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 840px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Blueprint Project Card */
  .project-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal),
      box-shadow var(--duration-normal);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--blue);
    box-shadow: 0 16px 36px var(--grid-glow);
  }

  /* Schematic Banner */
  .card-schematic-banner {
    background-color: var(--surface-soft);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .schematic-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    border-bottom: 1px dashed var(--border);
    background-color: color-mix(in srgb, var(--surface) 60%, transparent);
  }

  .schematic-canvas {
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-svg {
    width: 100%;
    max-height: 100px;
    display: block;
  }

  /* Card Content */
  .card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .status-completed .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime);
  }

  .project-title {
    font-size: clamp(1.2rem, 2vw, 1.35rem);
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .project-title a:hover {
    color: var(--blue);
  }

  .project-detail-block {
    margin-bottom: var(--space-3);
  }

  .detail-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 2px;
  }

  .detail-text {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .detail-text.highlight {
    color: var(--text);
    font-weight: 500;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border);
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--lime);
    text-decoration: none;
    transition:
      transform var(--duration-fast),
      color var(--duration-fast);
  }

  .case-study-link:hover {
    transform: translateX(3px);
    color: color-mix(in srgb, var(--lime) 80%, white);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .repo-link:hover {
    color: var(--blue);
  }

  .text-blue {
    color: var(--blue);
  }
  .text-dim {
    color: var(--text-dim);
  }
</style>
