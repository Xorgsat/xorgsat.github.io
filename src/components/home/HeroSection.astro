---
// src/components/home/HeroSection.astro
import TechTag from '@components/ui/TechTag.astro';

const coreTech = ['Playwright', 'TypeScript', 'Python', 'Selenium', 'Appium', 'Docker', 'CI/CD'];
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-group">
        <span class="status-indicator">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Open for International Remote Roles &amp; Quality Consulting</span>
        </span>
      </div>

      <h1 id="hero-heading" class="hero-title">Senior SDET &amp; Quality Engineering Architect</h1>

      <p class="hero-lead">
        <strong>8 years of experience</strong> engineering resilient, maintainable test automation systems
        across UI, API, mobile, and CI/CD pipelines.
      </p>

      <p class="hero-subtext">
        Specialized in test architecture, deterministic test isolation, flaky test elimination, and
        building fast, reliable release feedback gates for high-velocity software engineering teams.
      </p>

      <div class="hero-tech-stack" aria-label="Core Technical Stack">
        <span class="tech-stack-label">Core Stack:</span>
        <div class="tech-tags">
          {coreTech.map((tech) => <TechTag label={tech} variant="accent" />)}
        </div>
      </div>

      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">
          <span>View 12 Engineering Projects</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/contact" class="btn btn-secondary">Get in Touch</a>
      </div>

      <div class="hero-social-links" aria-label="Professional Profiles">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path>
          </svg>
          <span>GitHub</span>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <span class="separator" aria-hidden="true">&bull;</span>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span>LinkedIn</span>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <span class="separator" aria-hidden="true">&bull;</span>
        <a href="/about" class="social-link">
          <span>Read Architecture Philosophy &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column;
  }

  .hero-content {
    max-width: 860px;
  }

  .hero-badge-group {
    margin-bottom: var(--space-4);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background-color: var(--status-success-bg);
    border: 1px solid var(--status-success);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--status-success);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--status-success);
  }

  .hero-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }

  .hero-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .hero-lead {
      font-size: var(--text-xl);
    }
  }

  .hero-subtext {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 740px;
  }

  .hero-tech-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-3) var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .tech-stack-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: var(--text-inverse);
    border: 1px solid var(--accent-primary);
  }

  .btn-primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    text-decoration: none;
  }

  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }

  .btn-secondary:hover {
    background-color: var(--bg-subtle);
    border-color: var(--text-secondary);
    text-decoration: none;
  }

  .hero-social-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .separator {
    color: var(--border-default);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
