---
// src/components/home/ExperienceHighlights.astro
import MetricCard from '@components/ui/MetricCard.astro';
import { profile } from '../../config/profile';

const primaryMetrics = [
  {
    channel: 'CH-01 // PRODUCTION TENURE',
    value: `${profile.experienceYears}+ Years`,
    label: 'SDET & Quality Leadership',
    context:
      '8 years engineering reliable test systems across high-velocity teams, enterprise fintech, and distributed microservices.',
    verified: true,
  },
  {
    channel: 'CH-02 // SYSTEM ENGINES',
    value: `${profile.metrics.frameworksCount}`,
    label: 'Production Frameworks Engineered',
    context:
      '12 custom frameworks built from the ground up across Web (Playwright, Puppeteer), Mobile (Appium), and API microservices.',
    verified: true,
  },
  {
    channel: 'CH-03 // SCALE IN CI',
    value: profile.metrics.automatedTests,
    label: 'Automated Tests in CI',
    context:
      'Over 13,000 automated scenarios maintained across 28,000 career test cases, with zero tolerance for masked flaky failures.',
    verified: true,
  },
  {
    channel: 'CH-04 // EFFICIENCY',
    value: profile.metrics.regressionReduction,
    label: 'Regression Cycle Reduction',
    context: `Compressed 3-day manual regression runs (${profile.metrics.regressionManualTime}) down to ${profile.metrics.regressionAutomatedTime} automated (${profile.metrics.regressionSpeedup} speedup in production release cycles).`,
    verified: true,
  },
];
---

<section class="highlights-section section" aria-labelledby="highlights-heading">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">VERIFIED CAREER METRICS</span>
      <h2 id="highlights-heading" class="display-title section-title">
        Engineering Metrics &amp; Quality Impact<span class="accent-text">.</span>
      </h2>
      <p class="section-description">
        Evidence-based outcomes from eight years of testing distributed enterprise systems,
        microservices, financial ledgers, and customer-facing web applications.
      </p>
    </div>

    <!-- 4-Channel Precision Instrumentation Grid -->
    <div class="metrics-grid">
      {
        primaryMetrics.map((m) => (
          <MetricCard
            channel={m.channel}
            value={m.value}
            label={m.label}
            context={m.context}
            verified={m.verified}
          />
        ))
      }
    </div>

    <!-- Telemetry Telemetry Breakdown Panel -->
    <div class="telemetry-panel blueprint-frame">
      <div class="telemetry-header">
        <div class="header-left">
          <span class="mono text-xs text-blue"
            >CAREER TEST INVENTORY: 28,000+ VERIFIED SCENARIOS</span
          >
          <span class="live-dot" aria-hidden="true"></span>
        </div>
        <span class="mono text-xs text-dim">DISTRIBUTED ACROSS 4 PRODUCT DOMAINS</span>
      </div>

      <div class="telemetry-body">
        <div class="telemetry-row">
          <div class="telemetry-col">
            <span class="mono text-xs muted">LIFETIME TEST CASES:</span>
            <span class="mono text-sm bold text-text">28,000+ Scenarios</span>
          </div>
          <div class="telemetry-col">
            <span class="mono text-xs muted">AUTOMATED VOLUME:</span>
            <span class="mono text-sm bold text-lime">~13,000 (46.4% Share)</span>
          </div>
          <div class="telemetry-col">
            <span class="mono text-xs muted">DEFECTS ISOLATED:</span>
            <span class="mono text-sm bold text-blue">1,500 – 2,000 Pre-Prod</span>
          </div>
          <div class="telemetry-col">
            <span class="mono text-xs muted">RELEASE SPEEDUP:</span>
            <span class="mono text-sm bold text-lime">9.6x Faster Feedback</span>
          </div>
        </div>

        <div class="distribution-bar" aria-label="Test Distribution by Domain">
          <div
            class="dist-segment dist-ui"
            style="width: 39.3%;"
            title="UI Automation: 39.3% (11,000)"
          >
            UI: 39%
          </div>
          <div
            class="dist-segment dist-api"
            style="width: 17.9%;"
            title="API Testing: 17.9% (5,000)"
          >
            API: 18%
          </div>
          <div
            class="dist-segment dist-mobile"
            style="width: 17.9%;"
            title="Mobile Testing: 17.9% (5,000)"
          >
            MOBILE: 18%
          </div>
          <div
            class="dist-segment dist-int"
            style="width: 17.9%;"
            title="Integration: 17.9% (5,000)"
          >
            INT: 18%
          </div>
          <div
            class="dist-segment dist-perf"
            style="width: 7.0%;"
            title="Performance & Load: 7.0% (2,000)"
          >
            PERF: 7%
          </div>
        </div>
      </div>

      <div class="telemetry-footer">
        <p class="mono text-xs text-muted m-0">
          <strong>Engineering Integrity Disclosure:</strong> Metrics strictly distinguish total test cases
          handled (~28,000 across UI, API, Mobile, Integration, and Load) from tests automated (~13,000).
          The 89.6% cycle compression represents standard working hours (24 hrs) compressed into deterministic
          CI parallel execution (2.5 hrs).
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .highlights-section {
    background-color: color-mix(in srgb, var(--surface) 40%, var(--bg));
  }

  .section-header {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .section-title {
    margin-bottom: var(--space-2);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Telemetry Breakdown Panel */
  .telemetry-panel {
    margin-top: var(--space-6);
    background-color: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .telemetry-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background-color: var(--surface-soft);
    border-bottom: 1px solid var(--border);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime);
    box-shadow: 0 0 6px var(--lime);
  }

  .telemetry-body {
    padding: 18px;
  }

  .telemetry-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .telemetry-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .telemetry-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .distribution-bar {
    display: flex;
    height: 24px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 24px;
    text-align: center;
    color: #ffffff;
  }

  .dist-ui {
    background-color: #125c9b;
  }
  .dist-api {
    background-color: #0f6c79;
  }
  .dist-mobile {
    background-color: #13602d;
  }
  .dist-int {
    background-color: #1a4f78;
  }
  .dist-perf {
    background-color: #7c2d12;
  }

  .telemetry-footer {
    padding: 12px 18px;
    background-color: var(--surface-soft);
    border-top: 1px dashed var(--border);
  }

  .text-text {
    color: var(--text);
  }
  .text-blue {
    color: var(--blue);
  }
  .text-lime {
    color: var(--lime);
  }
  .bold {
    font-weight: 700;
  }
  .m-0 {
    margin: 0;
  }
</style>
