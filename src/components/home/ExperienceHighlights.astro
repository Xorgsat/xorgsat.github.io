---
// src/components/home/ExperienceHighlights.astro
import MetricCard from '@components/ui/MetricCard.astro';
import { profile } from '../../config/profile';

const metrics = [
  {
    value: `${profile.experienceYears}+ Years`,
    label: 'QA / SDET Experience',
    context:
      'Proven track record engineering robust quality architecture across high-velocity teams and distributed systems.',
    verified: true,
  },
  {
    value: `${profile.metrics.frameworksCount}`,
    label: 'Automation Frameworks Built',
    context:
      'Custom architectures built across UI (Playwright, Puppeteer, Selenium), Mobile (Appium), and API/contracts.',
    verified: true,
  },
  {
    value: profile.metrics.automatedTests,
    label: 'Automated Tests Built',
    context:
      'Spanning 28,000 lifetime test cases handled, representing a 46.4% career automation share across 4 major frameworks.',
    verified: true,
  },
  {
    value: profile.metrics.regressionReduction,
    label: 'Regression Cycle Reduction',
    context: `Compressed 3-day manual regression runs (${profile.metrics.regressionManualTime}) down to ${profile.metrics.regressionAutomatedTime} automated (${profile.metrics.regressionSpeedup} speedup).`,
    verified: true,
  },
];
---

<section class="highlights-section" aria-labelledby="highlights-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-kicker">Verified Track Record</span>
      <h2 id="highlights-heading" class="section-title">
        Engineering Metrics &amp; Quality Impact
      </h2>
      <p class="section-description">
        Evidence-based achievements across eight years of testing distributed enterprise systems,
        microservices, and web applications.
      </p>
    </div>

    <div class="metrics-grid">
      {
        metrics.map((m) => (
          <MetricCard value={m.value} label={m.label} context={m.context} verified={m.verified} />
        ))
      }
    </div>

    <div class="integrity-disclosure">
      <p>
        <strong>Note on Metrics:</strong> All figures represent aggregated experience across commercial
        engagements and independent framework engineering. Figures strictly distinguish test cases handled
        (~28,000 total across UI, API, Mobile, Integration, and Load) from tests automated (~13,000).
        The 89.6% regression cycle reduction compares 24 standard working hours to 2.5 automated hours.
      </p>
    </div>
  </div>
</section>

<style>
  .highlights-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .section-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .section-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .integrity-disclosure {
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background-color: var(--bg-surface);
    border-left: 3px solid var(--accent-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .integrity-disclosure p {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }
</style>
