---
// src/components/home/PhilosophySection.astro
const principles = [
  {
    number: '01',
    title: 'Deterministic State & Test Isolation',
    description:
      'Tests must be completely independent and hermetic. Sharing mutable state or relying on ordering side-effects creates brittle suites. Every test creates its own fixtures and cleans up after itself.',
  },
  {
    number: '02',
    title: 'Flaky Tests Are Defects, Not Inconveniences',
    description:
      'Blind retry loops mask architectural race conditions. We eliminate flakiness at the root using smart event-driven synchronization, network idle listeners, and isolated browser storage.',
  },
  {
    number: '03',
    title: 'Risk-Based Automation over Vanity Metrics',
    description:
      'Aiming for 100% UI automation has negative ROI. We prioritize high-impact financial transactions, user journeys, and complex business logic, delegating unit and contract testing to faster lower layers.',
  },
  {
    number: '04',
    title: 'Actionable Diagnostics over Binary Failures',
    description:
      'A failed test is useless if it takes hours to diagnose. Every failure must produce localized console errors, network HAR captures, video artifacts, and exact step traces to unblock developers immediately.',
  },
  {
    number: '05',
    title: 'Decoupled Framework Architecture',
    description:
      'Separating locator strategies, test data generators, and business workflows into modular abstractions ensures that UI redesigns require updating a single component object, not rewriting 50 test cases.',
  },
  {
    number: '06',
    title: 'Fast CI Feedback Loops',
    description:
      'Test automation must accelerate development velocity, not stall it. Through test sharding, containerized execution, and targeted test selection, regression feedback should take minutes, not hours.',
  },
];
---

<section class="philosophy-section" aria-labelledby="philosophy-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-kicker">Engineering Mindset</span>
      <h2 id="philosophy-heading" class="section-title">
        Automation &amp; Quality Engineering Philosophy
      </h2>
      <p class="section-description">
        Principles honed over eight years of delivering high-reliability test automation for
        production systems.
      </p>
    </div>

    <div class="principles-grid">
      {
        principles.map((p) => (
          <div class="principle-card">
            <span class="principle-number" aria-hidden="true">
              {p.number}
            </span>
            <h3 class="principle-title">{p.title}</h3>
            <p class="principle-description">{p.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .section-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
  }

  .section-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .principle-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    position: relative;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast);
  }

  .principle-card:hover {
    border-color: var(--border-default);
  }

  .principle-number {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: var(--space-2);
    line-height: 1;
  }

  .principle-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug, 1.3);
  }

  .principle-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }
</style>
