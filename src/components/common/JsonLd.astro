---
// src/components/common/JsonLd.astro
import { profile } from '../../config/profile';

interface Props {
  type?: 'Person' | 'Article';
  title?: string;
  description?: string;
  publishDate?: Date;
  canonicalUrl?: string;
}

const {
  type = 'Person',
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.experienceYears} years of experience engineering reliable automation systems across UI, API, mobile, and CI/CD pipelines.`,
  publishDate,
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://portfolio.example.com';

const schemaData =
  type === 'Article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description: description,
        datePublished: publishDate?.toISOString(),
        url: canonicalUrl,
        author: {
          '@type': 'Person',
          name: profile.name,
          jobTitle: profile.role,
          url: profile.githubUrl,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            url: siteUrl,
            name: `${profile.name} — Senior SDET Portfolio`,
            description: description,
          },
          {
            '@type': 'Person',
            '@id': `${siteUrl}/#person`,
            name: profile.name,
            jobTitle: profile.role,
            description: description,
            url: siteUrl,
            sameAs: [profile.githubUrl, profile.linkedinUrl],
            knowsAbout: [
              'Software Quality Engineering',
              'Test Automation Architecture',
              'Playwright',
              'Selenium WebDriver',
              'Appium',
              'TypeScript',
              'Python',
              'API Contract Testing',
              'Performance Engineering',
              'CI/CD Pipeline Automation',
            ],
          },
        ],
      };
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
