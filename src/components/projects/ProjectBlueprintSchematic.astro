---

<div
  class="blueprint-schematic-component blueprint-frame"
  id="project-blueprint-schematic"
  data-active-mode="system"
>
  <!-- Blueprint Title Block Bar -->
  <div class="schematic-title-block">
    <div class="title-block-main">
      <div class="dwg-number-badge mono">
        <span class="dwg-label">DRAWING NO.</span>
        <span class="dwg-code">{dwgId}</span>
      </div>
      <div class="dwg-meta">
        <span class="dwg-title">{title}</span>
        <span class="dwg-sub mono text-xs">{category} &bull; {projectType}</span>
      </div>
    </div>
    <div class="title-block-status mono text-xs">
      <span class="status-indicator-live">
        <span class="pulse-dot"></span>
        <span id="spec-status-indicator">VERIFIED ARCHITECTURE</span>
      </span>
      <span class="text-dim">SCALE: 1:1 // SHEET 01</span>
    </div>
  </div>

  <!-- Perspective Mode Selector Tabs -->
  <div class="schematic-modes" role="tablist" aria-label="Architectural Perspective Selector">
    <button
      type="button"
      role="tab"
      id="tab-mode-system"
      class="mode-btn mono text-xs active"
      aria-selected="true"
      aria-controls="blueprint-canvas-region"
      data-mode="system"
    >
      <span class="mode-num">01</span>
      <span>SYSTEM ARCHITECTURE</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-mode-problem"
      class="mode-btn mono text-xs"
      aria-selected="false"
      aria-controls="blueprint-canvas-region"
      data-mode="problem"
    >
      <span class="mode-num">02</span>
      <span>PROBLEM &amp; FAILURE VECTORS</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-mode-harness"
      class="mode-btn mono text-xs"
      aria-selected="false"
      aria-controls="blueprint-canvas-region"
      data-mode="harness"
    >
      <span class="mode-num">03</span>
      <span>TEST HARNESS &amp; INVARIANTS</span>
    </button>
  </div>

  <!-- Interactive SVG Blueprint Canvas -->
  <div
    class="blueprint-canvas-wrapper"
    id="blueprint-canvas-region"
    tabindex="0"
    role="region"
    aria-label={`${title} Architectural Blueprint Diagram`}
  >
    <div class="grid-watermark" aria-hidden="true">{spec.specTitle} &bull; {dwgId}</div>

    <!-- Architectural SVG Blueprint Diagram -->
    <svg
      class="blueprint-svg"
      viewBox="0 0 940 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Base Grid / Construction Backplane -->
      <line
        x1="40"
        y1="170"
        x2="900"
        y2="170"
        stroke="var(--border-strong)"
        stroke-width="1.5"
        stroke-dasharray="4 4"
        class="bus-line"></line>

      <!-- Connecting Data Channels -->
      <path
        d="M 180 170 L 260 170 M 420 170 L 500 170 M 660 170 L 740 170"
        stroke="var(--border-strong)"
        stroke-width="2"
        class="signal-connector"></path>

      <!-- Dynamic Fault Vector Path (Illuminates in Problem Mode) -->
      <path
        d="M 260 140 C 210 90, 470 70, 420 140"
        stroke="#ef4444"
        stroke-width="2.5"
        stroke-dasharray="6 4"
        class="fault-vector-path"></path>

      <!-- Dynamic Test Harness Verification Feedback Loop (Illuminates in Harness Mode) -->
      <path
        d="M 180 170 L 180 270 L 580 270 L 580 215"
        stroke="var(--blue)"
        stroke-width="2"
        stroke-dasharray="4 3"
        class="harness-path"></path>

      <!-- NODE 1: Ingress / Client / Runner -->
      <g class="bp-node node-ingress" transform="translate(40, 110)">
        <rect
          width="140"
          height="120"
          rx="4"
          fill="var(--surface)"
          stroke="var(--border-strong)"
          stroke-width="1.5"
          class="node-box"></rect>
        <rect width="140" height="24" rx="4" fill="var(--surface-soft)"></rect>
        <text
          x="12"
          y="16"
          fill="var(--blue)"
          font-family="var(--font-mono)"
          font-size="10"
          font-weight="700"
        >
          {spec.node1.tag}
        </text>
        <text
          x="12"
          y="48"
          fill="var(--text)"
          font-family="var(--font-sans)"
          font-size="12"
          font-weight="600"
        >
          {spec.node1.title}
        </text>
        <text x="12" y="68" fill="var(--text-muted)" font-family="var(--font-mono)" font-size="10">
          {spec.node1.line1}
        </text>
        <text x="12" y="86" fill="var(--text-dim)" font-family="var(--font-mono)" font-size="10">
          {spec.node1.line2}
        </text>
        <circle cx="140" cy="60" r="4" fill="var(--lime)"></circle>
      </g>

      <!-- NODE 2: Critical Risk & Problem Zone -->
