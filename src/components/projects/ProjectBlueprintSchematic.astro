          width="160"
          height="145"
          rx="4"
          fill="var(--surface)"
          stroke="var(--border-strong)"
          stroke-width="1.5"
          class="problem-box"></rect>
        <rect width="160" height="24" rx="4" fill="var(--surface-soft)" class="problem-header-rect"
