---
// src/components/projects/ProjectBlueprintSchematic.astro
interface Props {
  slug: string;
  title: string;
  category: string;
  projectType: string;
  businessProblem: string;
  engineeringFocus: string;
}

const { slug, title, category, projectType, businessProblem, engineeringFocus } = Astro.props;

// Determine architectural domain for blueprint illustration
function getDomain(slug: string): string {
  if (slug.includes('banking')) return 'banking';
  if (slug.includes('hrm')) return 'hrm';
  if (slug.includes('ecommerce')) return 'ecommerce';
  if (slug.includes('playwright') || slug.includes('brel')) return 'playwright';
  if (slug.includes('performance') || slug.includes('pizza')) return 'performance';
  if (slug.includes('mobile')) return 'mobile';
  if (slug.includes('cicd') || slug.includes('platform')) return 'cicd';
  return 'api';
}

const domain = getDomain(slug);
const dwgId = `DWG-SPEC-${slug.replace(/[^a-zA-Z0-9]/g, '-').toUpperCase()}`;
---

<div class="blueprint-schematic-component blueprint-frame" id="project-blueprint-schematic">
  <!-- Blueprint Title Block Bar -->
  <div class="schematic-title-block">
    <div class="title-block-main">
      <div class="dwg-number-badge mono">
        <span class="dwg-label">DRAWING NO.</span>
        <span class="dwg-code">{dwgId}</span>
      </div>
      <div class="dwg-meta">
        <span class="dwg-title">{title}</span>
        <span class="dwg-sub mono text-xs">{category} &bull; {projectType}</span>
      </div>
    </div>
    <div class="title-block-status mono text-xs">
      <span class="status-indicator-live">
        <span class="pulse-dot"></span>
        <span>VERIFIED ARCHITECTURE</span>
      </span>
      <span class="text-dim">SCALE: 1:1 // SHEET 01</span>
    </div>
  </div>

  <!-- Perspective Mode Selector Tabs -->
  <div class="schematic-modes" role="tablist" aria-label="Architectural Perspective Selector">
    <button
      type="button"
      role="tab"
      id="tab-mode-system"
      class="mode-btn mono text-xs active"
      aria-selected="true"
      aria-controls="blueprint-canvas-region"
      data-mode="system"
    >
      <span class="mode-num">01</span>
      <span>SYSTEM ARCHITECTURE</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-mode-problem"
      class="mode-btn mono text-xs"
      aria-selected="false"
      aria-controls="blueprint-canvas-region"
      data-mode="problem"
    >
      <span class="mode-num">02</span>
      <span>PROBLEM &amp; FAILURE VECTORS</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-mode-harness"
      class="mode-btn mono text-xs"
      aria-selected="false"
      aria-controls="blueprint-canvas-region"
      data-mode="harness"
    >
      <span class="mode-num">03</span>
      <span>TEST HARNESS &amp; INVARIANTS</span>
    </button>
  </div>

  <!-- Interactive SVG Blueprint Canvas -->
  <div
    class="blueprint-canvas-wrapper"
    id="blueprint-canvas-region"
    tabindex="0"
    role="region"
    aria-label={`${title} Architectural Blueprint Diagram`}
