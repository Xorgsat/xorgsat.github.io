<script
  define:vars={{
    specTitle: spec.specTitle,
    faultTag: spec.faultTag,
    harnessTag: spec.harnessTag,
    problemDetail: spec.problemDetail,
    harnessDetail: spec.harnessDetail,
    businessProblem,
    engineeringFocus,
  }}
>
  function setupBlueprintSchematic() {
    const component = document.getElementById('project-blueprint-schematic');
    if (!component) return;

    const tabs = component.querySelectorAll('.mode-btn');
    const annotationText = document.getElementById('blueprint-annotation-text');
    const problemHeader = document.getElementById('telemetry-problem-header');
    const problemBody = document.getElementById('telemetry-problem-body');
    const harnessHeader = document.getElementById('telemetry-harness-header');
    const harnessBody = document.getElementById('telemetry-harness-body');
    const statusIndicator = document.getElementById('spec-status-indicator');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const mode = tab.getAttribute('data-mode') || 'system';
        component.setAttribute('data-active-mode', mode);

        if (mode === 'problem') {
          if (annotationText) annotationText.textContent = faultTag;
          if (problemHeader)
            problemHeader.innerHTML =
              'PROBLEM STATEMENT &bull; <span class="highlight-warn">CRITICAL FAILURE VECTORS:</span>';
          if (problemBody)
            problemBody.textContent = `${problemDetail} Blast radius affects data consistency, system linearizability, and business operations under concurrent load.`;
          if (harnessHeader)
            harnessHeader.innerHTML = 'ENGINEERING DEFENSE &bull; TARGET FAILURE IMPACT:';
          if (harnessBody)
            harnessBody.textContent = `Without defensive invariants, this vulnerability triggers silent data corruption, customer churn, and SEV-1 production incidents.`;
          if (statusIndicator) statusIndicator.textContent = 'FAILURE VECTOR SIMULATION';
        } else if (mode === 'harness') {
          if (annotationText) annotationText.textContent = harnessTag;
          if (problemHeader)
            problemHeader.innerHTML = 'PROBLEM STATEMENT &bull; SYSTEM RISK ADDRESSED:';
          if (problemBody) problemBody.textContent = businessProblem;
          if (harnessHeader)
            harnessHeader.innerHTML =
              'ENGINEERING DEFENSE &bull; <span class="highlight-pass">TEST HARNESS & INVARIANTS:</span>';
          if (harnessBody)
            harnessBody.textContent = `${harnessDetail} Quality gates strictly enforce 0 flakes, 0 unhandled retries, and exit code 0.`;
          if (statusIndicator) statusIndicator.textContent = 'QUALITY GATES ENFORCED';
        } else {
          // System Overview
          if (annotationText) annotationText.textContent = harnessTag;
          if (problemHeader) problemHeader.innerHTML = 'PROBLEM STATEMENT &bull; RISK VECTOR:';
          if (problemBody) problemBody.textContent = businessProblem;
          if (harnessHeader) harnessHeader.innerHTML = 'ENGINEERING DEFENSE &bull; TEST HARNESS:';
          if (harnessBody) harnessBody.textContent = engineeringFocus;
          if (statusIndicator) statusIndicator.textContent = 'VERIFIED ARCHITECTURE';
        }
      });
    });
  }

  setupBlueprintSchematic();
  document.addEventListener('astro:after-swap', setupBlueprintSchematic);
</script>

