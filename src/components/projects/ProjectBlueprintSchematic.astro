<script>
  function setupBlueprintSchematic() {
    const component = document.getElementById('project-blueprint-schematic');
    if (!component) return;

    const tabs = component.querySelectorAll<HTMLButtonElement>('.mode-btn');
    const problemBox = component.querySelector<SVGRectElement>('.problem-box');
    const harnessNodes = component.querySelectorAll<SVGElement>('.node-engine, .harness-path');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const mode = tab.getAttribute('data-mode');

        if (mode === 'problem') {
          if (problemBox) {
            problemBox.style.stroke = 'var(--lime)';
            problemBox.style.strokeWidth = '2.5px';
          }
          harnessNodes.forEach((el) => {
            el.style.opacity = '0.4';
          });
        } else if (mode === 'harness') {
          if (problemBox) {
            problemBox.style.stroke = 'var(--border-strong)';
            problemBox.style.strokeWidth = '1.5px';
          }
          harnessNodes.forEach((el) => {
            el.style.opacity = '1';
          });
        } else {
          // System Overview
          if (problemBox) {
            problemBox.style.stroke = 'var(--border-strong)';
            problemBox.style.strokeWidth = '1.5px';
          }
          harnessNodes.forEach((el) => {
            el.style.opacity = '1';
          });
        }
      });
    });
  }

  setupBlueprintSchematic();
  document.addEventListener('astro:after-swap', setupBlueprintSchematic);
</script>

