---
// src/components/projects/ProjectBlueprintSchematic.astro
interface Props {
  slug: string;
  title: string;
  category: string;
  projectType: string;
  businessProblem: string;
  engineeringFocus: string;
}

const { slug, title, category, projectType, businessProblem, engineeringFocus } = Astro.props;

// Determine architectural domain for blueprint illustration
function getDomain(slug: string): string {
  if (slug.includes('banking')) return 'banking';
  if (slug.includes('hrm')) return 'hrm';
  if (slug.includes('ecommerce')) return 'ecommerce';
  if (slug.includes('commercial-web')) return 'web';
  if (slug.includes('commercial-api')) return 'commercial-api';
  if (slug.includes('commercial-mobile')) return 'commercial-mobile';
  if (slug.includes('commercial-performance')) return 'commercial-performance';
  if (slug.includes('playwright') || slug.includes('brel')) return 'playwright';
  if (slug.includes('performance') || slug.includes('pizza')) return 'performance';
  if (slug.includes('mobile')) return 'mobile';
  if (slug.includes('cicd') || slug.includes('platform')) return 'cicd';
  return 'api';
}

const domain = getDomain(slug);
const dwgId = `DWG-SPEC-${slug.replace(/[^a-zA-Z0-9]/g, '-').toUpperCase()}`;

